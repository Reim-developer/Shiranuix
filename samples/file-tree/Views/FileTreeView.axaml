<?xml version="1.0" encoding="utf-8"?>
<!--
  The file tree's own view.

  A UserControl rather than markup-only: the tree needs to answer four
  questions the markup cannot, and all four are about the tree's state
  rather than about drawing - which row is open, which row is being
  renamed, what the arrow keys mean, and what a menu item should act on.

  The shape is the one every editor's file tree has: a heading with the
  folder's own name and the buttons that do something to it, and then rows. A
  row is one line, twenty-two points high, and it is a twisty, a symbol, a name
  and nothing else - the name is the only text in a row because the name is
  the whole point of a row. Folders sit above files, guide lines show how deep
  a row sits, and a long name is cut off with an ellipsis rather than pushing
  the tree wider than its column.

  There is no box to type a filter into. A tree this narrow has room for rows
  and a heading and nothing else, and a filter that only reaches three levels
  of what has already been read is a filter that answers the wrong question:
  a writer who types a name wants to be taken to it, not to be shown a list
  of folders that happen to contain it.

  Nothing here draws its own symbols: the tree asks the Lucide set the
  editor's own toolbar is drawn from, so the whole window is one hand.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nodes="using:FileTree.Nodes"
             xmlns:state="using:FileTree.State"
             xmlns:trim="using:FileTree.Views"
             x:Class="FileTree.Views.FileTreeView"
             x:DataType="state:FileTreeState"
             x:CompileBindings="True">

    <Grid RowDefinitions="Auto,*"
          HorizontalAlignment="Stretch"
          ClipToBounds="True">

        <!-- The heading: what the tree is standing on, and the four things
             a writer does to a folder without using the keyboard. Buttons
             rather than words, because a column this narrow has no room for
             words, and the icons are what a writer recognises anyway. -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="10,6,6,4">

            <TextBlock Grid.Column="0"
                       Text="{Binding RootName}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding HasRoot}"
                       ToolTip.Tip="{Binding RootName}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">

                <!-- Where the tree stands is the one thing a writer cannot
                     reach any other way once a folder is shown: the empty
                     state's button is gone, and the editor has no palette to
                     type a gesture into. So it is here too. -->
                <Button Classes="tree-action"
                        Click="OnOpenFolderClick"
                        IsVisible="{Binding HasRoot}"
                        ToolTip.Tip="Open another folder"
                        AutomationProperties.Name="Open folder">
                    <LucideIcon Kind="FolderOpen"
                                Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                Size="14" StrokeWidth="2"/>
                </Button>

                <Button Classes="tree-action"
                        Click="OnNewFileClick"
                        IsVisible="{Binding HasRoot}"
                        ToolTip.Tip="New file"
                        AutomationProperties.Name="New file">
                    <LucideIcon Kind="FilePlus"
                                Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                Size="14" StrokeWidth="2"/>
                </Button>

                <Button Classes="tree-action"
                        Click="OnNewFolderClick"
                        IsVisible="{Binding HasRoot}"
                        ToolTip.Tip="New folder"
                        AutomationProperties.Name="New folder">
                    <LucideIcon Kind="FolderPlus"
                                Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                Size="14" StrokeWidth="2"/>
                </Button>

                <Button Classes="tree-action"
                        Click="OnRefreshClick"
                        IsVisible="{Binding HasRoot}"
                        ToolTip.Tip="Read the folder again (F5)"
                        AutomationProperties.Name="Refresh">
                    <LucideIcon Kind="RotateCw"
                                Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                Size="14" StrokeWidth="2"/>
                </Button>

                <Button Classes="tree-action"
                        Click="OnCollapseAllClick"
                        IsVisible="{Binding HasRoot}"
                        ToolTip.Tip="Close every folder"
                        AutomationProperties.Name="Collapse all">
                    <LucideIcon Kind="ChevronsDownUp"
                                Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                Size="14" StrokeWidth="2"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- The tree. No horizontal scrollbar: a tree that can be dragged
             sideways is a tree whose rows decide how wide the column is, and
             the column belongs to the window. -->
        <TreeView Grid.Row="1"
                  x:Name="Rows"
                  Background="Transparent"
                  ItemsSource="{Binding Items}"
                  SelectionChanged="OnRowSelected"
                  KeyDown="OnTreeKeyDown"
                  DoubleTapped="OnRowActivated"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">

            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New file" Click="OnNewFileClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="FilePlus"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New folder" Click="OnNewFolderClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="FolderPlus"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Rename" Click="OnRenameClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="SquarePen"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Move to…" Click="OnMoveToClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="FolderInput"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mark" Click="OnMarkClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="Check"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2.4"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy path" Click="OnCopyPathClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="ClipboardCopy"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Show in folder" Click="OnRevealClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="FolderOpen"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Hidden files" Click="OnHiddenClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="Eye"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sort by name" Click="OnSortNameClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="ArrowUpDown"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sort by kind" Click="OnSortKindClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="ArrowUpDown"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sort by date" Click="OnSortDateClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="ArrowUpDown"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Reverse order" Click="OnSortDirectionClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="ArrowUpDown"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Delete" Click="OnDeleteClick">
                        <MenuItem.Icon>
                            <LucideIcon Kind="Trash"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="14" StrokeWidth="2"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.Styles>
                <!-- The container's open state comes from the row and only
                     goes that way. Avalonia starts every container closed, so
                     a two-way binding writes "closed" into the row as it
                     builds - which is how the root of a tree ends up shut on
                     the first frame, and how a writer ends up clicking twice.

                     One way means one source of truth: the row. This view
                     opens and closes rows itself, from a click, from a key,
                     and from the twisty it draws. -->
                <Style Selector="TreeViewItem" x:DataType="nodes:FileTreeItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                    <Setter Property="Padding" Value="0"/>
                </Style>

                <!-- Avalonia's own twisty is hidden, and only that: this row draws
                     one beside the name it belongs to, and two arrows on one
                     row is one arrow too many whichever of them works. Named
                     rather than matched by type, so the row's own header can
                     never be caught by the same rule. -->
                <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
                    <Setter Property="IsVisible" Value="False"/>
                </Style>

                <!-- Chosen over hovered, not highlighted: a tree is mostly
                     read, and a background loud enough to be noticed beats a
                     tree a writer cannot scan. The accent is for things being
                     acted on, not for the row under the pointer. -->
                <Style Selector="TreeViewItem:pointerover /template/ Border">
                    <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
                </Style>
                <Style Selector="TreeViewItem:selected /template/ Border">
                    <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="nodes:FileTreeItem">

                    <!-- One line, twenty-two points high. The press is not handled here:
                         Avalonia's own row control takes it first and marks
                         it handled, so a handler attached to this border
                         never hears a click - the view listens in the tunnel
                         phase instead, which is before anything can swallow
                         it. -->
                    <Border Background="Transparent"
                            MinHeight="22"
                            Padding="0,0,6,0">

                        <StackPanel Orientation="Horizontal" Spacing="4">

                            <!-- One line per folder above, so a row at the
                                 fourth level says how it got there. -->
                            <ItemsControl ItemsSource="{Binding Guides}"
                                          VerticalAlignment="Stretch"
                                          IsVisible="{Binding HasGuides}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:Int32">
                                        <Border Width="8"
                                                BorderThickness="1,0,0,0"
                                                BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                                Margin="0,0,0,0"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- A row the writer has marked says so with a
                                 tick, not with a second column of words. -->
                            <LucideIcon Kind="Check"
                                        Foreground="{DynamicResource Sx.AccentBrush}"
                                        Size="11"
                                        StrokeWidth="2.6"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsMarked}"/>

                            <!-- The twisty: a closed folder points right, an
                                 open one points down, and a file has none at
                                 all - an empty square is not a symbol for
                                 "nothing to open". -->
                            <LucideIcon Kind="ChevronRight"
                                        Foreground="{DynamicResource Sx.TextTertiaryBrush}"
                                        Size="13"
                                        StrokeWidth="2"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsClosed}"/>

                            <LucideIcon Kind="ChevronDown"
                                        Foreground="{DynamicResource Sx.TextTertiaryBrush}"
                                        Size="13"
                                        StrokeWidth="2"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsOpen}"/>

                            <LucideIcon Kind="Folder"
                                        Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                        Size="15"
                                        StrokeWidth="1.9"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsDirectory}"/>

                            <LucideIcon Kind="File"
                                        Foreground="{DynamicResource Sx.TextTertiaryBrush}"
                                        Size="15"
                                        StrokeWidth="1.9"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsDirectory}"/>

                            <!-- Folders are said in the stronger colour and
                                 files in the quieter one, which is what makes
                                 a wall of them readable at a glance. A name
                                 too long for the column keeps both ends: the
                                 beginning says what it is, the end says what
                                 kind of thing it is. -->
                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       trim:MiddleTrim.Shorten="True"
                                       Foreground="{DynamicResource Sx.TextPrimaryBrush}"
                                       IsVisible="{Binding IsDirectory}"/>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       trim:MiddleTrim.Shorten="True"
                                       Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                       IsVisible="{Binding !IsDirectory}"/>

                            <!-- The name is edited where it is written, the way
                                 every tree does it and the way a dialog a
                                 writer has to find again never is. -->
                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                     IsVisible="{Binding IsEditing}"
                                     FontSize="12"
                                     Padding="2,0"
                                     MinWidth="110"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameFinished"/>
                        </StackPanel>
                    </Border>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

    </Grid>

    <UserControl.Styles>
        <!-- A button with no words in it: the icon is the whole control, so
             the padding is the gap and not a frame. -->
        <Style Selector="Button.tree-action">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.tree-action:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
        </Style>
    </UserControl.Styles>
</UserControl>