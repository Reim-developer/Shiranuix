<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The assembly is named after the plugin, because that is the rule the
         editor follows: a plugin's folder, its manifest id and its assembly
         all carry the same name. -->
    <AssemblyName>file-tree</AssemblyName>
    <RootNamespace>FileTree</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin's own copy of the view-model toolkit, brought in by the
         plugin and loaded into the plugin's world. The editor's copy is in the
         editor's world; neither sees the other, which is exactly what the
         isolation is for. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Icons: Lucide, the set the editor draws every symbol from, named
         rather than drawn. The plugin says "folder-tree" and gets the same
         hand as the editor's own toolbar - no drawings to carry, and the
         editor is free to redraw the set without touching this plugin. -->
    <PackageReference Include="Lucide.Avalonia" Version="0.2.26" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shiranuix.Plugins\Shiranuix.Plugins.csproj" />
    <ProjectReference Include="..\..\Shiranuix.Plugins.UI\Shiranuix.Plugins.UI.csproj" />
    <ProjectReference Include="..\..\Shiranuix.Plugins.Testing\Shiranuix.Plugins.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What a drag may be dropped on, and how a long name is shortened, are
         the tree's own rules and worth testing directly; the view itself is
         left internal because a control is not what a test is asking about. -->
    <InternalsVisibleTo Include="Shiranuix.FileTree.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>