<?xml version="1.0" encoding="utf-8"?>
<!--
  The file tree's own view.

  A UserControl rather than markup-only: the tree needs to answer four
  questions the markup cannot, and all four are about the tree's state
  rather than about drawing - which row is open, which row is being
  renamed, what the arrow keys mean, and what a menu item should act on.

  Everything you can see here is drawn by TreeIcons, as geometry, in the
  editor's own colours - so it is right in the dark theme without a second
  drawing, and nothing depends on a font being installed. There is no
  text in a row but its name, and the tree's own two lines of status live
  in the editor's status line instead, where the writer has already looked
  a hundred times.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tree="using:FileTree"
             x:Class="FileTree.FileTreeView"
             x:DataType="tree:FileTreeState"
             x:CompileBindings="True">


    <Grid RowDefinitions="Auto,*" Background="Transparent">

        <!-- One row of chrome: a lens, a box to type in, and a way to read
             the folder again. The refresh button is here rather than in the
             tree because F5 is not the only way a writer looks for a button. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,6,6,4">

            <Path Grid.Column="0"
                  Data="{x:Static tree:TreeIcons.Search}"
                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                  StrokeThickness="1.4"
                  Width="13" Height="13"
                  VerticalAlignment="Center"/>

            <TextBox Grid.Column="1"
                     x:Name="FilterBox"
                     Margin="6,0,0,0"
                     Padding="4,2"
                     FontSize="12"
                     MinHeight="24"
                     Classes="search-box"
                     PlaceholderText="Filter"
                     Text="{Binding Filter, Mode=TwoWay}"
                     KeyDown="OnFilterKeyDown"/>

            <Button Grid.Column="2"
                    Classes="find-button"
                    Width="24" Height="24"
                    Padding="0"
                    Margin="4,0,0,0"
                    Click="OnRefreshClick"
                    ToolTip.Tip="Read the folder again (F5)">
                <Path Data="{x:Static tree:TreeIcons.Refresh}"
                      Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                      StrokeThickness="1.4"
                      Width="12" Height="12"/>
            </Button>
        </Grid>

        <!-- The tree. A row is a twisty, a shape and a name, and nothing else;
             the name is the only text in it because the name is the whole
             point of a row. -->
        <TreeView Grid.Row="1"
                  x:Name="Rows"
                  Background="Transparent"
                  ItemsSource="{Binding Items}"
                  SelectionChanged="OnRowSelected"
                  KeyDown="OnTreeKeyDown"
                  DoubleTapped="OnRowActivated">

            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New file" Click="OnNewFileClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.NewFile}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="New folder" Click="OnNewFolderClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.NewFolder}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Rename" Click="OnRenameClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Rename}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mark" Click="OnMarkClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Mark}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.4"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Copy path" Click="OnCopyPathClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.CopyPath}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Show in folder" Click="OnRevealClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Reveal}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Hidden files" Click="OnHiddenClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Hidden}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sort by name" Click="OnSortNameClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Sort}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sort by kind" Click="OnSortKindClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Sort}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Sort by date" Click="OnSortDateClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Sort}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Reverse order" Click="OnSortDirectionClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Sort}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.3"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Delete" Click="OnDeleteClick">
                        <MenuItem.Icon>
                            <Path Data="{x:Static tree:TreeIcons.Delete}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.2"
                                  Width="13" Height="13"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </TreeView.ContextMenu>

            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="Padding" Value="0,1"/>
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}" x:DataType="tree:FileTreeItem">
                    <Border Background="Transparent" Padding="0,1">

                        <StackPanel Orientation="Horizontal" Spacing="4">

                            <!-- A row the writer has marked says so with a tick
                                 rather than a second column of text. -->
                            <Path Data="{x:Static tree:TreeIcons.Mark}"
                                  Stroke="{DynamicResource Sx.AccentBrush}"
                                  StrokeThickness="1.6"
                                  Width="11" Height="11"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsMarked}"/>

                            <!-- The twisty: a closed folder points right, an
                                 open one points down, and a file has none at
                                 all - an empty square is not a symbol for
                                 "nothing to open". -->
                            <Path Stroke="{DynamicResource Sx.TextTertiaryBrush}"
                                  StrokeThickness="1.5"
                                  Width="9" Height="9"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsClosed}"
                                  Data="{x:Static tree:TreeIcons.ChevronRight}"/>

                            <Path Stroke="{DynamicResource Sx.TextTertiaryBrush}"
                                  StrokeThickness="1.5"
                                  Width="9" Height="9"
                                  Margin="2,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsOpen}"
                                  Data="{x:Static tree:TreeIcons.ChevronDown}"/>

                            <Path Data="{x:Static tree:TreeIcons.Folder}"
                                  Fill="{DynamicResource Sx.TextSecondaryBrush}"
                                  Opacity="0.85"
                                  Width="14" Height="14"
                                  Margin="1,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding IsDirectory}"/>

                            <Path Data="{x:Static tree:TreeIcons.File}"
                                  Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                                  StrokeThickness="1.1"
                                  Width="11" Height="11"
                                  Margin="1,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding !IsDirectory}"/>

                            <TextBlock Text="{Binding Name}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="3,0,0,0"/>

                            <!-- The name is edited where it is written, the way
                                 every tree does it and the way a dialog a
                                 writer has to find again never is. -->
                            <TextBox Text="{Binding Name, Mode=TwoWay}"
                                     IsVisible="{Binding IsEditing}"
                                     FontSize="12"
                                     Padding="2,0"
                                     MinWidth="110"
                                     KeyDown="OnRenameKeyDown"
                                     LostFocus="OnRenameFinished"/>
                        </StackPanel>
                    </Border>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- No folder yet: a tree with nothing to show says so in one line and
             offers the one thing that would give it something. -->
        <StackPanel Grid.Row="1"
                    Margin="12"
                    Spacing="8"
                    IsVisible="{Binding !HasRoot}">
            <Path Data="{x:Static tree:TreeIcons.Folder}"
                  Fill="{DynamicResource Sx.TextTertiaryBrush}"
                  Width="20" Height="20"
                  HorizontalAlignment="Center"/>
            <TextBlock Text="No folder"
                       FontSize="12"
                       Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <Button Classes="find-button"
                    HorizontalAlignment="Center"
                    Click="OnOpenFolderClick">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Data="{x:Static tree:TreeIcons.Reveal}"
                          Stroke="{DynamicResource Sx.TextSecondaryBrush}"
                          StrokeThickness="1.2"
                          Width="12" Height="12"/>
                    <TextBlock Text="Open folder" FontSize="12"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>