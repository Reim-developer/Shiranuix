<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The assembly is named after the plugin, because that is the rule the
         editor follows: a plugin's folder, its manifest id and its assembly
         all carry the same name. -->
    <AssemblyName>reading-time</AssemblyName>
    <RootNamespace>ReadingTime</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The one thing a plugin builds against. No Avalonia, no view model
         toolkit, nothing the editor has to agree with at runtime. -->
    <ProjectReference Include="..\..\Shiranuix.Plugins\Shiranuix.Plugins.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Travels beside the assembly so the folder a plugin ships in is a
         folder the editor can read. -->
    <None Include="manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>