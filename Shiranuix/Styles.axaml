<!--
  Shiranuix application styles.

  Built on the design tokens declared in Themes/Palette.axaml (the `Sx.*`
  brushes) plus the retuned Fluent palette, so every rule below adapts to the
  active light/dark variant automatically.

  The visual language:

  * Warm cream (light) or plum (dark) surfaces — never neutral grey.
  * Rounded everything: pill buttons, 10px cards, circular thumbs.
  * Soft shadows with a warm tint instead of hairline dividers.
  * One rose accent, used for emphasis and gentle "chip" fills rather than
    for decoration everywhere.
  * Nunito for the interface, with ExtraBold reserved for headings so titles
    read friendly rather than corporate; Georgia for the document itself.

  Style selectors here use classes (`.accent`, `.editor`), which are style
  *triggers* — a higher priority than the plain type setters inside Fluent's
  control themes, so these rules win even when Fluent styles the same
  property.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Typography ================================================== -->

    <Style Selector="TextBlock.section-title">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="0.2"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.placeholder-title">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.placeholder-body">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
    </Style>

    <!-- ===== Shell (window app bar) ====================================== -->

    <Style Selector="Border.app-bar">
        <Setter Property="Background" Value="{DynamicResource Sx.AppBarBrush}"/>
        <Setter Property="Padding" Value="22,11"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- The little rose badge next to the title. -->
    <Style Selector="Border.app-badge">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="BoxShadow" Value="0 3 8 -3 #59C6445E"/>
    </Style>

    <Style Selector="Path.app-badge-icon">
        <Setter Property="Fill" Value="#FFFFFFFF"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <Style Selector="TextBlock.app-title">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="LetterSpacing" Value="0.2"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.app-bar-hint">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Buttons ===================================================== -->

    <!-- Secondary action: a soft rose chip (the theme toggle). -->
    <Style Selector="Button.button-ghost">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="13,6"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.button-ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.button-ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftHoverBrush}"/>
    </Style>
    <Style Selector="Button.button-ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftPressedBrush}"/>
    </Style>
    <Style Selector="Button.button-ghost:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
    </Style>

    <!-- Primary action: a rounded pill with a warm glow. -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.OnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <!-- The Button template is a ContentPresenter, and that (unlike Button)
         is what carries BoxShadow — so the glow lives here. -->
    <Style Selector="Button.accent /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.OnAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BoxShadow" Value="0 4 12 -2 #40C6445E"/>
        <Setter Property="Transitions">
            <Transitions>
                <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
            </Transitions>
        </Setter>
    </Style>
    <!-- Hover darkens rather than lightens: white text keeps its contrast. -->
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentHoverBrush}"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentPressedBrush}"/>
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter">
        <Setter Property="BoxShadow" Value="0 1 4 -1 #40C6445E"/>
    </Style>
    <Style Selector="Button.accent:disabled">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
    </Style>
    <Style Selector="Button.accent:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
        <Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
    </Style>

    <!-- File actions in the app bar: text-level, not pills. Four filled
         buttons would out-shout the document, and these are things you do
         *to* the page rather than things the app is proud of. -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
    </Style>

    <!-- Hairline between the file actions and the theme toggle. -->
    <Style Selector="Border.tool-sep">
        <Setter Property="Background" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="7,5"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <!-- Recent files on the start screen: a flat list, so a long path reads
         as a line of text rather than as a button competing with the page. -->
    <Style Selector="Button.recent">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.recent /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.recent:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Sx.AccentBrush}"/>
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
    </Style>

    <!-- ===== Writing surface ============================================= -->

    <!--
      The editor deliberately does not use Fluent's TextBox theme. Fluent's
      TextBox is a *form control*: bordered, padded, sized to its content, and
      ringed on focus. A page you type a chapter into wants none of that, so
      the border, background and focus visuals are all replaced and the
      scrollbar is left to the theme's slimmed track.
    -->
    <Style Selector="TextBox.editor">
        <Setter Property="FontFamily" Value="{DynamicResource Sx.PageFont}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="LineHeight" Value="29"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <!-- Inset from the sheet's edges so the text sits *on* the page
             rather than being flush with its border. -->
        <Setter Property="Margin" Value="44,38,44,110"/>
    </Style>

    <Style Selector="TextBox.editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox.editor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.editor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--
      The sheet itself: a centred column floating on the desk colour.

      HorizontalAlignment must be Stretch, not Center. Layoutable.ArrangeCore
      sizes a Center element to its DesiredSize, and an empty TextBox desires
      only about 80px, so the page collapsed to a sliver. Stretch takes the
      full available width, MinMax clamps it to MaxWidth, and the same arrange
      pass centres the result — full-width and centred at once.

      780px is roughly 66 characters of Georgia: the readable upper bound for
      serif prose. Wider than that and the eye loses the line return.
    -->
    <Style Selector="Border.measure">
        <Setter Property="MaxWidth" Value="780"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="30,20,30,20"/>

        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="CornerRadius" Value="10"/>

        <!-- The lift under the sheet. A warm tint rather than pure black so
             the shadow belongs to the palette; the top margin matches the
             blur so it cannot bleed onto the app bar. -->
        <Setter Property="BoxShadow" Value="0 4 20 0 #263D2E33"/>
    </Style>

    <!-- ===== Status bar ================================================== -->

    <Style Selector="Border.editor-status">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="22,7"/>
    </Style>

    <Style Selector="TextBlock.editor-meta">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== ToolTip ===================================================== -->

    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

</Styles>
