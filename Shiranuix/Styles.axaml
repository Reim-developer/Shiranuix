<!--
  Shiranuix application styles.

  Built on the design tokens declared in Themes/Palette.axaml (the `Sx.*`
  brushes) plus the retuned Fluent palette, so every rule below adapts to the
  active light/dark variant automatically.

  The visual language is deliberately the restrained one of an office tool,
  because that is what this is meant to read as:

  * White chrome bands over a grey workspace — the same two-tone split Word
    uses, so the sheet has somewhere to sit.
  * Tight corner radii (4px). Friendly 10px+ radii read as a consumer app.
  * Hairlines in a neutral, never a tinted shadow standing in for one.
  * One accent — Office brand blue — reserved for state and emphasis, not
    scattered across the chrome.
  * The platform's default typeface for the interface. The document uses
    whatever typeface the user picks.

  Style selectors here use classes (`.tool`, `.editor`, `.measure`), which are
  style *triggers* — a higher priority than the plain type setters inside
  Fluent's control themes, so these rules win even when Fluent styles the
  same property.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Dialog ========================================================= -->

    <!--
        The one window every dialog is drawn in. Silent, centred, and sized by
        its message rather than by a fixed box.
    -->
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="Padding" Value="22,18,22,20"/>
    </Style>

    <Style Selector="TextBlock.dialog-message">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="LineHeight" Value="19"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.dialog-button">
        <Setter Property="MinWidth" Value="104"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <!-- ===== Settings ==================================================== -->

    <!--
        The window the title band's gear opens: one heading, quiet rows, the
        same surface as the sheet so it reads as part of the document's
        chrome rather than a foreign prompt.
    -->
    <Style Selector="Border.settings-body">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="Padding" Value="24,20,24,24"/>
    </Style>

    <Style Selector="TextBlock.settings-heading">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.settings-label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
    </Style>
    <!-- ===== Settings ==================================================== -->

    <!-- A line that says what a row is doing rather than what it is: the
         theme is a name, this is a sentence. -->
    <Style Selector="TextBlock.settings-hint">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- The on/off switch a plugin row carries, sized for a narrow window. -->
    <Style Selector="ToggleSwitch">
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Typography ================================================== -->

    <Style Selector="TextBlock.placeholder-title">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
    </Style>

    <Style Selector="TextBlock.placeholder-body">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
    </Style>

    <!-- ===== Shell: title band ============================================ -->

    <!-- Flat white, not a gradient: Word's chrome is flat. -->
    <Style Selector="Border.app-bar">
        <Setter Property="Background" Value="{DynamicResource Sx.AppBarBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <!-- The app mark: a brand-blue square carrying the initial, the same
         device the Office icons use. Flat, no glow, no badge. -->
    <Style Selector="Border.app-mark">
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource Sx.AccentBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.app-mark-letter">
        <Setter Property="Text" Value="S"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.OnAccentBrush}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.app-title">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Hairline between the app name and the open document. -->
    <Style Selector="Border.doc-sep">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="17"/>
        <Setter Property="Background" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="10,0,10,0"/>
    </Style>

    <!-- ===== Shell: format band =========================================== -->

    <!-- The grey band under the title bar, holding the document's typography
         controls. Same two-tone split Word uses to separate chrome from
         chrome-that-changes-the-document. -->
    <Style Selector="Border.format-bar">
        <Setter Property="Background" Value="{DynamicResource Sx.ChromeBrush}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
    </Style>

    <Style Selector="TextBlock.field-label">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ComboBox.field">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="MinHeight" Value="29"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Buttons ===================================================== -->

    <!-- Secondary action: the theme toggle. A soft accent chip rather than a
         filled button, so it does not compete with the file commands. -->
    <Style Selector="Button.button-ghost">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.button-ghost /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.button-ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftHoverBrush}"/>
    </Style>
    <Style Selector="Button.button-ghost:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftPressedBrush}"/>
    </Style>
    <Style Selector="Button.button-ghost:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
    </Style>

    <!-- File commands in the title band: text-level, not filled. Four filled
         buttons would out-shout the document, and these are things you do
         *to* the page rather than things the app is proud of. -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="9,5"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.tool /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
    </Style>
    <Style Selector="Button.tool:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.BorderSoftBrush}"/>
    </Style>

    <!-- The icons the file commands are drawn in: sized to sit like the
         12.5pt labels they replaced, thin enough to read as a line rather
         than a shape, and tinted by whatever button they sit in. Lucide
         measures from a 24-unit grid, so the stroke is set to sit right at
         16 rather than at the 24 it was drawn at. -->
    <Style Selector=".tool-icon" x:SetterTargetType="LucideIcon">
        <Setter Property="Size" Value="16"/>
        <Setter Property="StrokeWidth" Value="2"/>
    </Style>

    <!-- Recent files on the start screen: a flat list, so a long path reads
         as a line of text rather than as a button competing with the page. -->
    <Style Selector="Button.recent">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.recent /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.recent:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Sx.AccentBrush}"/>
    </Style>
    <Style Selector="Button.recent:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
    </Style>

    <!-- ===== Writing surface ============================================= -->

    <!--
      The editor deliberately does not use Fluent's TextBox theme. Fluent's
      TextBox is a *form control*: bordered, padded, sized to its content, and
      ringed on focus. A page you type a chapter into wants none of that, so
      the border, background and focus visuals are all replaced and the
      scrollbar is left to the theme's slimmed track.

      Font family and size are NOT set here — they come from the view model,
      because the user chooses them and the same choice drives the pickers.
      The line height is not set here either, and for the same reason: it
      follows the point size, which the view model owns.
    -->
    <Style Selector="TextBox.editor">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="Cursor" Value="IBeam"/>
        <!-- Inset from the sheet's edges so the text sits *on* the page
             rather than being flush with its border. -->
        <Setter Property="Margin" Value="60,44,60,110"/>
    </Style>

    <Style Selector="TextBox.editor /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="TextBox.editor:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.editor:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!--
      The line-number gutter: a hairline away from the text, quiet enough to be
      looked past. The numbers are right-aligned so they read as a margin, and
      their line height is bound in the view to the same value the page uses —
      that binding is what keeps a number on its line.
    -->
    <Style Selector="Border.line-gutter">
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
    </Style>

    <Style Selector="TextBlock.line-number">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <!-- Centred in the column, not pinned to the text's edge: a gutter of
             numbers is a margin, and a right-aligned run of them reads as a
             column that slipped. -->
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <!--
      The window's edge cues: a small arrow at the top or bottom of the page
      while the file carries lines beyond the window standing there. The same
      quiet grey as the numbers and barely larger — the cue is a note in the
      margin, not a control, and it disappears the moment the window stands
      on the file's own edge.
    -->
    <Style Selector="TextBlock.window-cue">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="Opacity" Value="0.75"/>
    </Style>

    <!--
      The sheet itself: a centred column floating on the workspace colour.
      Square corners — a page is square, and the rounding was the single
      detail most at odds with reading as a tool.

      HorizontalAlignment must be Stretch, not Center. Layoutable.ArrangeCore
      sizes a Center element to its DesiredSize, and an empty TextBox desires
      only about 80px, so the page collapsed to a sliver. Stretch takes the
      full width of the column it sits in; the same arrange pass fills it.

      The width itself is not set here, because it is no longer a constant.
      The wrapper grid in the view splits the row 5/90/5, so the page takes
      90% of whatever the window offers and the desk keeps its share on either
      side. Widening the window widens the page — the old `MaxWidth="816"`
      stopped at 816px no matter how much room there was, which is exactly
      what made large type awkward: at 48pt the sheet was margins plus a
      line of about twenty characters. What is left below is the vertical
      inset of desk above and below the sheet.
    -->
    <Style Selector="Border.measure">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="0,18,0,18"/>

        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="CornerRadius" Value="0"/>

        <!-- The lift under the sheet. A soft neutral rather than pure black so
             it belongs to the palette; the top margin matches the blur so it
             cannot bleed onto the chrome above. In dark the page already
             differs from the workspace by value, so this barely shows — which
             is the right amount of shadow there. -->
        <Setter Property="BoxShadow" Value="0 3 14 0 #24000000"/>
    </Style>

    <!-- ===== Status bar ================================================== -->

    <Style Selector="Border.editor-status">
        <Setter Property="Background" Value="{DynamicResource Sx.ChromeBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,6"/>
    </Style>

    <Style Selector="TextBlock.editor-meta">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The bar's one clickable segment: the line sequence. It reads as the
         other meta text at rest and lifts a touch on hover, so the choice is
         discoverable without shouting. -->
    <Style Selector="Button.status-segment">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.status-segment /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.status-segment:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.BorderSoftBrush}"/>
    </Style>
    <Style Selector="Button.status-segment:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Sx.BorderSoftBrush}"/>
    </Style>

    <!-- ===== Font preview =================================================
         The card floating beside the font picker while its list is open. It
         reads as a small lifted page — same surface, border and lift as the
         sheet — and the typeface it draws in is set from code-behind, so the
         family and the ink below stay a view concern: only the size comes
         from the view model, because that is the size the document will use. -->
    <Style Selector="Border.font-preview">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="MaxWidth" Value="440"/>
        <Setter Property="BoxShadow" Value="0 3 14 0 #24000000"/>
    </Style>

    <Style Selector="TextBlock.font-preview-sample">
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ===== ToolTip ===================================================== -->

    <Style Selector="ToolTip">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- ===== Find ========================================================= -->
    <!-- The find bar: a small box in the page's top-right corner. -->
    <Style Selector="Border.find-bar">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="MinWidth" Value="360"/>
        <Setter Property="MaxWidth" Value="460"/>
    </Style>

    <!-- The panel column: a surface beside the desk rather than on it, with a
         hairline between the two so the page's edge stays where it was. -->
    <Style Selector="Border.panel-column">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
    </Style>

    <Style Selector="TextBlock.empty-panel">
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="14"/>
    </Style>

    <Style Selector="TabControl.panel-tabs">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <Style Selector="Button.find-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

    <Style Selector="ToggleButton.find-toggle">
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.find-toggle:checked">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.AccentBrush}"/>
    </Style>


    <!-- A plugin's on/off switch: a small pill in the same hand as the find
         bar's toggles, because Avalonia's own ToggleButton is neither this
         editor's colour nor this editor's shape. -->
    <!-- A plugin's on/off switch: a small pill in the editor's own accent, because
         Avalonia's own check box is neither this editor's colour nor this
         editor's shape. The row already says what it means in words, so the
         switch only has to be legible. -->
    <Style Selector="Button.plugin-switch">
        <Setter Property="MinWidth" Value="52"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
    </Style>

    <!-- The pressed state of the pill, rather than a checked state: a button
         carries no check, and the label is the state. -->
    <Style Selector="Button.plugin-switch:pressed">
        <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftPressedBrush}"/>
    </Style>
</Styles>
