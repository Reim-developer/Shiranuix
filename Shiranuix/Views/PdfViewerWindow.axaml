<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        x:Class="Shiranuix.Views.PdfViewerWindow"
        x:DataType="vm:PdfViewerState"
        Title="{Binding Title}"
        Width="900"
        Height="960"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1F1F1F"
        FontFamily="{DynamicResource ContentControlThemeFontFamily}">

    <!--
        The reader: a paper shown beside the writing, not in its place. The
        reading stands on one page at a time — the page shown whole, never
        cut — and steps on and back by the buttons, the wheel, and the keys.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="10,6"
                Background="#2A2A2A">
            <DockPanel>
                <Button Content="Close"
                        Click="OnClose"
                        Focusable="False"
                        DockPanel.Dock="Left"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Button x:Name="Previous"
                            Content="‹ Previous"
                            Click="OnPrevious"
                            Focusable="False"/>
                    <TextBlock x:Name="Place"
                               VerticalAlignment="Center"
                               Foreground="#DDDDDD"/>
                    <Button x:Name="Next"
                            Content="Next ›"
                            Click="OnNext"
                            Focusable="False"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="Stage">
            <Border BoxShadow="0 2 14 0 #66000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Image x:Name="Leaf" Stretch="Fill"/>
            </Border>
        </Grid>

    </Grid>

</Window>
