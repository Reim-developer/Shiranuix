<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        x:Class="Shiranuix.Views.PdfViewerWindow"
        x:DataType="vm:PdfViewerState"
        Title="{Binding Title}"
        Width="900"
        Height="960"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <!--
        The reader: a paper shown beside the writing, not in its place. Its
        pages stand one after another in a scroll, each drawn when it comes
        under the eye and let go when it goes past; the button above shuts
        the reading away.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0"
                Padding="10,6">
            <Button Content="Close"
                    Click="OnClose"
                    HorizontalAlignment="Right"/>
        </Border>

        <ScrollViewer x:Name="Pane"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Pages"/>
        </ScrollViewer>

    </Grid>

</Window>
