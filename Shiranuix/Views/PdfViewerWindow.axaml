<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        x:Class="Shiranuix.Views.PdfViewerWindow"
        x:DataType="vm:PdfViewerState"
        Title="{Binding Title}"
        Width="900"
        Height="720"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        Background="#1F1F1F">

    <!--
        The reader: a paper shown beside the writing, not in its place. The
        reading stands on one page at a time — the page shown whole, never
        cut — and steps on and back by the buttons, the wheel, and the keys.
        The chrome keeps to the page's edges: the closing X above, the two
        steps below, so the glass between them is the paper's alone.
    -->

    <Window.Styles>
        <!-- The reader wears its own dark stage whatever the theme does, so
             the chrome carries its own light: a quiet touch on the buttons,
             a lighter one under the pointer, and a fading hand on a button
             that can no longer reach. -->
        <Style Selector="Button.reader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style Selector="Button.reader:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.reader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="Button.reader:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                Padding="10,6"
                Background="#2A2A2A">
            <Button Classes="reader"
                    Click="OnClose"
                    Focusable="False"
                    ToolTip.Tip="Close"
                    HorizontalAlignment="Right">
                <LucideIcon Classes="tool-icon" Kind="X"/>
            </Button>
        </Border>

        <Grid Grid.Row="1" x:Name="Stage">
            <Border BoxShadow="0 2 14 0 #66000000"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Image x:Name="Leaf" Stretch="Fill"/>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,8"
                Background="#2A2A2A">
            <StackPanel Orientation="Horizontal"
                        Spacing="16"
                        HorizontalAlignment="Center">
                <Button x:Name="Previous"
                        Classes="reader"
                        Click="OnPrevious"
                        Focusable="False"
                        ToolTip.Tip="Previous page">
                    <LucideIcon Classes="tool-icon" Kind="ChevronLeft"/>
                </Button>
                <TextBlock x:Name="Place"
                           VerticalAlignment="Center"
                           Foreground="#DDDDDD"/>
                <Button x:Name="Next"
                        Classes="reader"
                        Click="OnNext"
                        Focusable="False"
                        ToolTip.Tip="Next page">
                    <LucideIcon Classes="tool-icon" Kind="ChevronRight"/>
                </Button>
            </StackPanel>
        </Border>

    </Grid>

</Window>
