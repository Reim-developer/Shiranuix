<?xml version="1.0" encoding="utf-8"?>
<!--
  The command palette: a box over the page, with a line to type a command's
  name into and the rows that name answers.

  It is an overlay rather than a page because it is a question, not a place: it
  comes up over whatever the writer was doing, takes a name, and goes away
  having run one command. Nothing about the document is disturbed, so there is
  nothing here that saves, and nothing that asks.

  The rows are the commands, and they come from the editor's own table. A
  chord is written at the right where the command has one, which is the same
  place the keyboard settings write it: one shape for "this answers to that",
  read in two places.

  The highlighted row is drawn as standing out rather than selected, because
  the highlight is a caret moving through a list: Enter takes it, the arrows
  move it, and the mouse does not have to be involved at all.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shiranuix.ViewModels"
             x:Class="Shiranuix.Views.PaletteView"
             x:DataType="vm:PaletteState"
             x:CompileBindings="True">

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Border.palette">
            <Setter Property="Background" Value="{DynamicResource Sx.SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MaxWidth" Value="620"/>
        </Style>

        <Style Selector="Border.palette-row">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- The row Enter would take. One at a time, and only ever this one:
             anything else would say the list has two answers. -->
        <Style Selector="Border.palette-row.highlight">
            <Setter Property="Background" Value="{DynamicResource Sx.AccentSoftBrush}"/>
        </Style>

        <Style Selector="TextBlock.palette-name">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.palette-where">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.palette-says">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style Selector="TextBlock.palette-gesture">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- A row the command says it cannot run: still listed, because a writer
             looking for it should find it, and still told what it is - but
             drawn flat, the way a menu item a document cannot act on is drawn.
             Pressing it does nothing rather than failing after the fact. -->
        <Style Selector="Border.palette-row.dimmed">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <Style Selector="TextBlock.palette-hint">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource Sx.TextTertiaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="palette" HorizontalAlignment="Center" VerticalAlignment="Top"
            Margin="0,54,0,0" BoxShadow="0 18 48 0 #40000000">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!-- What has been typed. The box takes the keyboard while the
                 palette is up, so the arrows and Enter go to the palette and
                 not to the page underneath it. -->
            <TextBox x:Name="QueryBox"
                     Grid.Row="0"
                     Classes="search-box"
                     MinHeight="34"
                     Padding="12,7"
                     FontSize="13"
                     Text="{Binding Query, Mode=TwoWay}"
                     KeyDown="OnQueryKeyDown"
                     PlaceholderText="Type a command’s name…"/>

            <Rectangle Grid.Row="1" Height="1"
                       Margin="1,0"
                       Fill="{DynamicResource Sx.BorderSoftBrush}"/>

            <!-- The rows. A list that is always all of them rather than a
                 window onto them: a palette is short, and a scrollbar in a box
                 that answers six questions is a scrollbar nobody meant. -->
            <ListBox x:Name="Rows"
                     Grid.Row="2"
                     MaxHeight="330"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemsSource="{Binding Entries}"
                     SelectionMode="Single"
                     IsVisible="{Binding HasEntries}">

                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:PaletteEntry">
                        <Border Classes="palette-row"
                                Classes.highlight="{Binding IsHighlighted}"
                                Classes.dimmed="{Binding !CanRun}"
                                Margin="5,1">
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Classes="palette-name"
                                           Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis"/>

                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Classes="palette-gesture"
                                           Margin="12,0,0,0"
                                           Text="{Binding Gesture}"
                                           IsVisible="{Binding HasGesture}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Classes="palette-says"
                                           Margin="0,1,0,0"
                                           Text="{Binding Description}"
                                           IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- What the box says when nothing answers it. Said plainly,
                 because a box that is empty with no explanation reads as a
                 window that failed to open. -->
            <TextBlock Grid.Row="2"
                       Classes="palette-says"
                       Margin="14,14"
                       HorizontalAlignment="Center"
                       Text="{Binding EmptyMessage}"
                       IsVisible="{Binding IsEmpty}"/>

            <Rectangle Grid.Row="3" Height="1"
                       Margin="1,0"
                       Fill="{DynamicResource Sx.BorderSoftBrush}"
                       IsVisible="{Binding HasEntries}"/>

            <!-- The three keys, said once at the bottom rather than three
                 times on every row: Enter takes the row that stands out, the
                 arrows move it, and Escape puts the box away. -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        Spacing="14"
                        Margin="12,7"
                        IsVisible="{Binding HasEntries}">
                <TextBlock Classes="palette-hint" Text="Enter run"/>
                <TextBlock Classes="palette-hint" Text="↑ ↓ move"/>
                <TextBlock Classes="palette-hint" Text="Esc close"/>
            </StackPanel>

        </Grid>
    </Border>

</UserControl>