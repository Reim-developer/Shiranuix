<!--
  Shiranuix shell window.

  One app bar carries everything that is not the document: the badge and
  title, the file actions, and the theme toggle. Keeping it all in one bar is
  deliberate — a writing tool should spend its height on writing.

  Below that sits the document as a sheet on a desk: a centred measure column
  with its own surface, floating on the window's canvas colour, and a quiet
  status bar with the counts.

  The editor TextBox is deliberately not the Fluent themed one. Fluent's is a
  form control — bordered, padded, sized to its content — and every one of
  those traits is wrong for a page you type a chapter into. See Styles.axaml.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="760"
        x:Class="Shiranuix.Views.MainWindow"
        x:DataType="vm:EditorViewModel"
        Width="1080" Height="760"
        MinWidth="760" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Sx.CanvasBrush}"
        Title="{Binding Title}">

    <DockPanel>

        <!-- ===== App bar: branding left, actions right ================== -->
        <Border DockPanel.Dock="Top" Classes="app-bar">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal" Spacing="2"
                            VerticalAlignment="Center">
                    <Button Classes="tool" Content="New"
                            Command="{Binding NewDocumentCommand}"
                            HotKey="Ctrl+N"
                            ToolTip.Tip="New document"/>
                    <Button Classes="tool" Content="Open…"
                            Command="{Binding OpenCommand}"
                            HotKey="Ctrl+O"
                            ToolTip.Tip="Open a file"/>
                    <Button Classes="tool" Content="Save"
                            Command="{Binding SaveCommand}"
                            HotKey="Ctrl+S"
                            ToolTip.Tip="Save"/>
                    <Button Classes="tool" Content="Save As…"
                            Command="{Binding SaveAsCommand}"
                            HotKey="Ctrl+Shift+S"
                            ToolTip.Tip="Save to a new file"/>

                    <Border Classes="tool-sep"/>

                    <!-- Content binds the enum, so the pill reads "System",
                         "Light" or "Dark" and reports what a click will leave
                         it on. Cycles System → Light → Dark → System. -->
                    <Button Classes="button-ghost"
                            Content="{Binding ThemeMode}"
                            Command="{Binding CycleThemeCommand}"
                            ToolTip.Tip="Cycle between system, light and dark"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="11"
                            VerticalAlignment="Center">
                    <!-- Rose badge with a heart mark: the app's little logo. -->
                    <Border Classes="app-badge">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <LinearGradientBrush.GradientStops>
                                    <GradientStop Color="#FFE8798F" Offset="0"/>
                                    <GradientStop Color="#FFC6445E" Offset="1"/>
                                </LinearGradientBrush.GradientStops>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Classes="app-badge-icon"
                              Data="M12 21.35l-1.45-1.32C4.4 14.36 1 11.28 1 7.5 1 4.42 3.42 2 6.5 2c1.74 0 3.41.81 4.5 2.09C12.09 2.81 13.76 2 15.5 2 18.58 2 21 4.42 21 7.5c0 3.78-3.4 6.86-9.55 12.54L12 21.35z"/>
                    </Border>

                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <TextBlock Text="Shiranuix" Classes="app-title"/>
                        <TextBlock Text="plain text" Classes="app-bar-hint"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Status bar ============================================== -->
        <Border DockPanel.Dock="Bottom" Classes="editor-status">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Classes="editor-meta"
                           Text="{Binding StatusMessage}"/>
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <TextBlock Classes="editor-meta"
                               Text="{Binding WordCount, StringFormat={}{0} words}"/>
                    <TextBlock Classes="editor-meta"
                               Text="{Binding CharacterCount, StringFormat={}{0} characters}"/>
                    <TextBlock Classes="editor-meta"
                               Text="{Binding LineCount, StringFormat={}{0} lines}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Writing surface ========================================= -->
        <Panel>

            <Border Classes="measure">
                <TextBox Classes="editor"
                         Text="{Binding Text, Mode=TwoWay}"/>
            </Border>

            <!-- Start screen: sits over the empty sheet and hides the moment
                 there is a single character to write. -->
            <Border Classes="measure"
                    IsVisible="{Binding IsStartVisible}">
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Classes="placeholder-title"
                               Text="Start writing"
                               TextAlignment="Center"/>
                    <TextBlock Classes="placeholder-body"
                               Margin="0,4,0,18"
                               Text="Ctrl+O to open a file, or just begin typing."
                               TextAlignment="Center"/>

                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="recent"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[ItemsControl].((vm:EditorViewModel)DataContext).OpenRecentCommand}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Panel>

    </DockPanel>
</Window>
