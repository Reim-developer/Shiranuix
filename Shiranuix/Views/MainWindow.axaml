<!--
  Shiranuix editor window.

  Built as three parts, and deliberately not as a conventional "app shell":

  1. A slim title band holding the app mark, the file name and the file
     commands. No ribbon, no menu strip, no tabs — a writing tool's toolbar is
     a thin row of small type, the way a typewriter's paper bail is a bar
     rather than a panel.

  2. A grey format band holding the document's typography controls. The
     two-tone split (white over grey) is the one borrowed from Word, and it
     does real work: it separates chrome from chrome-that-changes-the-page.

  3. The rest — a single TextBox centred on the workspace colour, floating on
     it like paper on a desk. Its size comes from the window rather than from
     an assumed viewport: height by stretching the row, width by a wrapper
     grid that gives the sheet 90% of the row and leaves the desk its share
     either side. Enlarging the window enlarges the page, so a large point
     size still gets a line worth reading.

  The document's typeface and size live on the view model, not in a style,
  because the user picks them and the same values drive both the page and the
  two ComboBoxes. Avalonia has no rich-text control, so the choice applies to
  the whole document — which is why the picker reads as "the font", not as
  "the font of the selection".
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        xmlns:converters="using:Shiranuix.Converters"
        xmlns:views="clr-namespace:Shiranuix.Views"
        xmlns:system="using:System"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="960" d:DesignHeight="760"
        x:Class="Shiranuix.Views.MainWindow"
        x:DataType="vm:EditorViewModel"
        Width="960" Height="760"
        MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Title="{Binding Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ===== Title band ================================================
             Flat white, no gradient. The commands are glyphs rather than
             words — five icons read at a glance where five labels made the
             band a toolbar — and each one carries its words as a tip. -->
        <Border Grid.Row="0" Classes="app-bar">

            <DockPanel LastChildFill="False">

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button Classes="tool"
                            Command="{Binding NewDocumentCommand}"
                            ToolTip.Tip="New document"
                            AutomationProperties.Name="New">
                        <LucideIcon Classes="tool-icon" Kind="FilePlus"/>
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding OpenCommand}"
                            ToolTip.Tip="Open file…"
                            AutomationProperties.Name="Open">
                        <LucideIcon Classes="tool-icon" Kind="FileText"/>
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding OpenDirectoryCommand}"
                            ToolTip.Tip="Open folder."
                            AutomationProperties.Name="Open folder">
                        <LucideIcon Classes="tool-icon" Kind="FolderOpen"/>
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding SaveCommand}"
                            ToolTip.Tip="Save"
                            AutomationProperties.Name="Save">
                        <LucideIcon Classes="tool-icon" Kind="Save"/>
                    </Button>
                    <Button Classes="tool"
                            Command="{Binding SaveAsCommand}"
                            ToolTip.Tip="Save as…"
                            AutomationProperties.Name="Save As">
                        <LucideIcon Classes="tool-icon" Kind="SaveAll"/>
                    </Button>
                    <Button Classes="tool"
                            Click="OnOpenSettings"
                            ToolTip.Tip="Settings"
                            AutomationProperties.Name="Settings">
                        <LucideIcon Classes="tool-icon" Kind="Settings"/>
                    </Button>
                </StackPanel>

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Spacing="9">

                    <!-- The app mark: a brand-blue square carrying the
                         initial, the way the Office icons do. -->
                    <Border Classes="app-mark">
                        <TextBlock Classes="app-mark-letter"/>
                    </Border>

                    <TextBlock Classes="app-title" Text="Shiranuix"/>

                </StackPanel>

                <!-- The file name, sitting after the app name. Trimmed rather
                     than wrapped: a long path shortens at the end instead of
                     pushing the commands off the edge. -->
                <StackPanel Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Path}">

                    <Border Classes="doc-sep"/>

                    <TextBlock Text="{Binding Name}"
                               FontSize="13"
                               Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="320"/>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- ===== Format band ===============================================
             The document's typography controls. Small and quiet: findable
             without being looked at. -->
        <Border Grid.Row="1" Classes="format-bar">

            <DockPanel LastChildFill="False">

                <!-- Secondary, not primary: a soft accent chip rather than a
                     filled button, so it never competes with the file
                     commands or with the document. The theme itself lives in
                     the settings window, where it can be seen changing the
                     page behind it. -->
                <!-- Word wrap: off to begin. A page is what a writing tool
                     starts in; a line that runs past the paper wants the page
                     to scroll, not to be re-broken. -->
                <Button Classes="button-ghost"
                        DockPanel.Dock="Right"
                        Margin="0,0,8,0"
                        Content="{Binding WordWrapLabel}"
                        Command="{Binding ToggleWordWrapCommand}"
                        HorizontalAlignment="Right"
                        ToolTip.Tip="Wrap lines at the page's edge"/>

                <StackPanel Orientation="Horizontal" Spacing="8">

                    <TextBlock Classes="field-label" Text="Font"/>

                    <ComboBox Classes="field"
                              x:Name="FontCombo"
                              Width="200"
                              ItemsSource="{Binding AvailableFonts}"
                              SelectedItem="{Binding FontFamily}"
                              HorizontalAlignment="Left">

                        <!-- Every entry draws its own name in its own face,
                             the way a font list should: the list itself
                             becomes the first preview, one row at a time.
                             A face that is not installed falls back the same
                             way the document does — through the converter. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type system:String}">
                                <TextBlock Text="{Binding}"
                                           FontFamily="{Binding Converter={x:Static converters:StringToFontFamilyConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>

                    <!-- The sample: the typeface under the pointer or the
                         keyboard cursor, set as a pangram at the document's
                         own size, shown while the list is open and not a
                         moment longer. It takes no layout space — a Popup
                         measures 0,0 by contract — and its placement, open
                         state and the family it draws in are wired from
                         code-behind, beside the list's own events. -->
                    <Popup x:Name="FontPreview"
                           Placement="Right"
                           HorizontalOffset="6">
                        <Border Classes="font-preview">
                            <TextBlock Classes="font-preview-sample"
                                       x:Name="FontPreviewSample"
                                       Text="The quick brown fox jumps over the lazy dog"
                                       FontSize="{Binding FontSize}"/>
                        </Border>
                    </Popup>

                    <Border Width="1" Margin="7,3"
                            Background="{DynamicResource Sx.BorderSoftBrush}"/>

                    <TextBlock Classes="field-label" Text="Size"/>

                    <ComboBox Classes="field"
                              Width="74"
                              ItemsSource="{Binding FontSizes}"
                              SelectedItem="{Binding FontSize}"
                              HorizontalAlignment="Left">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type system:String}">
                                <TextBlock Text="{Binding Converter={x:Static converters:DoubleToSizeConverter.Instance}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- The faces and the line set: bold, italic, then flush
                         left, centred, or flush right. Each set sits in one
                         hairline box, its buttons kept together the way a
                         word processor's toolbar keeps its own, so the eye
                         reads two groups instead of five stray buttons. The
                         chip at work in each box answers with the accent the
                         rest of the bar answers with; the ones at rest stay
                         transparent and wait. -->
                    <Border Classes="chip-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="format-chip"
                                    Classes.current="{Binding Bold}"
                                    Command="{Binding ToggleBoldCommand}"
                                    ToolTip.Tip="Set the page's lines in a bold face"
                                    AutomationProperties.Name="Bold">
                                <LucideIcon Classes="tool-icon" Kind="Bold"/>
                            </Button>
                            <Button Classes="format-chip"
                                    Classes.current="{Binding Italic}"
                                    Command="{Binding ToggleItalicCommand}"
                                    ToolTip.Tip="Set the page's lines in an italic face"
                                    AutomationProperties.Name="Italic">
                                <LucideIcon Classes="tool-icon" Kind="Italic"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Classes="chip-group">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="format-chip"
                                    Classes.current="{Binding IsLeftAligned}"
                                    Command="{Binding AlignLeftCommand}"
                                    ToolTip.Tip="Align the page left"
                                    AutomationProperties.Name="Align left">
                                <LucideIcon Classes="tool-icon" Kind="TextAlignStart"/>
                            </Button>
                            <Button Classes="format-chip"
                                    Classes.current="{Binding IsCenterAligned}"
                                    Command="{Binding AlignCenterCommand}"
                                    ToolTip.Tip="Align the page centre"
                                    AutomationProperties.Name="Align centre">
                                <LucideIcon Classes="tool-icon" Kind="TextAlignCenter"/>
                            </Button>
                            <Button Classes="format-chip"
                                    Classes.current="{Binding IsRightAligned}"
                                    Command="{Binding AlignRightCommand}"
                                    ToolTip.Tip="Align the page right"
                                    AutomationProperties.Name="Align right">
                                <LucideIcon Classes="tool-icon" Kind="TextAlignEnd"/>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </DockPanel>

        </Border>

        <!-- ===== Writing surface ===========================================
             The sheet floats on the workspace colour. Its width follows the
             window rather than a fixed measure: the wrapper below splits the
             row 5/90/5, so the page takes 90% of whatever width is available
             and keeps desk on both sides. Widening the window widens the page
             instead of growing the margin around it.

             The start screen is an overlay on it rather than a separate
             page, so the empty document still reads as a page waiting for
             text. -->
        <Grid Grid.Row="2" Background="{DynamicResource Sx.CanvasBrush}">

            <!-- The panel column, down the left of the page, and the bar that
                 drags its width. It is a column of its own rather than one of
                 the page grid's, so that a panel cannot change the page's own
                 proportions: the sheet is 90% of what is left, whatever that
                 is. Both are hidden while the column holds nothing, so
                 the window a reader uses is the window they know.

                 The bounds are on the column rather than on the Border inside
                 it, because the bounds are what the splitter is held to: a
                 limit written on the Border limits how the Border is drawn,
                 while the column itself can still be dragged to any width the
                 window happens to have. The floor is zero while no panel is on
                 show, so an empty side bar costs nothing at all. The width is
                 set in code rather than bound: a column's width is a
                 GridLength, and a number that has to be dressed up as one on
                 every load is worse than two lines that say what they mean. -->
            <Grid x:Name="PageRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="{Binding Panel.SidebarFloor}"
                                     MaxWidth="{Binding Panel.SidebarCeiling}"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Classes="panel-column"
                        Grid.Column="0"
                        IsVisible="{Binding Panel.IsVisible}"
                        HorizontalAlignment="Stretch"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">

                        <!-- One tab per panel, in the order they arrived. A single
                             panel takes the whole column, the way a side bar
                             with one thing in it should. -->
                        <TabControl Grid.Row="0"
                                    Classes="panel-tabs"
                                    ItemsSource="{Binding Panel.Panels}"
                                    SelectedItem="{Binding Panel.Selected, Mode=TwoWay}">
                            <!-- An icon alone, with the name in a tip: a column
                                 this narrow has no room for a word in every
                                 tab, and the icon is the thing a writer
                                 recognises anyway. -->
                            <TabControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:IPanel">
                                    <Panel ToolTip.Tip="{Binding Title}"
                                           AutomationProperties.Name="{Binding Title}">
                                        <!-- The icon a panel names, drawn from
                                             the editor's own set; a glyph only
                                             for the panels that name nothing
                                             and brought a character instead. -->
                                        <LucideIcon Kind="{Binding Icon,
                                                Converter={x:Static views:PanelIconConverter.Instance}}"
                                                    Foreground="{DynamicResource Sx.TextSecondaryBrush}"
                                                    Size="16"
                                                    StrokeWidth="2"
                                                    IsVisible="{Binding Icon,
                                                          Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        <TextBlock Text="{Binding Glyph}"
                                                   FontSize="14"
                                                   IsVisible="{Binding Glyph,
                                                        Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                    </Panel>
                                </DataTemplate>
                            </TabControl.ItemTemplate>
                            <TabControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:IPanel">
                                    <ContentControl Content="{Binding View}"/>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>

                        <!-- What the panel says for itself when it has nothing
                             to say yet: an empty column is the editor's own
                             state, and this is where a writer sees that nothing
                             has been put in it. -->
                        <TextBlock Grid.Row="1"
                                   Classes="empty-panel"
                                   Text="No panel"
                                   IsVisible="{Binding !Panel.Count}"/>
                    </Grid>
                </Border>

                <!-- Drag to resize, double press to put it back, which is what every
                     side bar worth copying answers to. -->
                <GridSplitter Grid.Column="1"
                              ResizeDirection="Columns"
                              Background="Transparent"
                              Width="4"
                              DoubleTapped="OnSidebarDoubleTapped"
                              IsVisible="{Binding Panel.IsVisible}"/>

                <Grid Grid.Column="2" ColumnDefinitions="5*,90*,5*">

                <Border Classes="measure" Grid.Column="1">
                    <Grid ColumnDefinitions="46,*">

                        <!-- Line numbers: a quiet gutter down the page's left
                             edge, kept in step with the text by EditorGutter
                             — it scrolls the margin as the page scrolls and
                             redraws the numbers against the rows the editor
                             laid out, so a wrapped line keeps its number on
                             the row it starts on. -->
                        <Border Classes="line-gutter"
                                Grid.Column="0"
                                ClipToBounds="True"
                                VerticalAlignment="Stretch">
                            <TextBlock x:Name="LineNumbers"
                                       Classes="line-number"
                                       LineHeight="{Binding EditorLineHeight}"
                                       Margin="0,44,0,0"/>
                        </Border>

                        <TextBox x:Name="Editor"
                                 Classes="editor"
                                 Grid.Column="1"
                                 Text="{Binding Text, Mode=TwoWay}"
                                 TextWrapping="{Binding WordWrap, Converter={x:Static converters:BoolToWrapConverter.Instance}}"
                                 TextAlignment="{Binding TextAlign, Converter={x:Static converters:TextAlignToAlignmentConverter.Instance}}"
                                 FontFamily="{Binding FontFamily,
                                                    Converter={x:Static converters:StringToFontFamilyConverter.Instance}}"
                                 FontSize="{Binding FontSize}"
                                 FontWeight="{Binding Bold, Converter={x:Static converters:BoolToWeightConverter.Instance}}"
                                 FontStyle="{Binding Italic, Converter={x:Static converters:BoolToFontStyleConverter.Instance}}"
                                 LineHeight="{Binding EditorLineHeight}"
                                 CaretIndex="{Binding CaretIndex, Mode=TwoWay}"
                                 IsFocused="{Binding IsEditing, Mode=OneWayToSource}"
                                 IsUndoEnabled="False"
                                 Margin="14,44,60,110"
                         views:EditorGutter.Gutter="{Binding ElementName=LineNumbers}"
                         views:EditorGutter.Numbers="{Binding LineNumbersText}"/>

                        <!-- The window's edges say what waits beyond them: a
                             small arrow at the top of the page while the file
                             carries lines above the window, at the bottom
                             while it carries lines past it. Both live in the
                             page's own margins, where they never touch a
                             line of text. -->
                        <TextBlock Grid.Column="1"
                                   Classes="window-cue"
                                   Text="▲"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,14,0,0"
                                   IsVisible="{Binding HasLinesAbove}"/>

                        <TextBlock Grid.Column="1"
                                   Classes="window-cue"
                                   Text="▼"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,14"
                                   IsVisible="{Binding HasLinesBelow}"/>

                    </Grid>

                </Border>

            <!-- The find bar floats over the page's top-right corner. It has
                 to name the page's column: as a plain child of the grid
                 below it lands in column zero — the five-percent margin —
                 and a bar far wider than that margin hangs off the window's
                 edge, which is how it read the first time. -->
            <Border Classes="find-bar"
                    Grid.Row="2"
                    Grid.Column="1"
                    x:DataType="vm:FindState"
                    x:Name="FindBarHost"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,8,16,0"
                    IsVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBox x:Name="FindBox"
                             Width="220"
                             Classes="search-box"
                             TextWrapping="NoWrap"
                             VerticalAlignment="Center"
                             Text="{Binding Query, Mode=TwoWay}"
                             KeyDown="OnFindBoxKeyDown"/>
                    <ToggleButton x:Name="FindCaseToggle"
                                  Classes="find-toggle"
                                  Content="Aa"
                                  IsChecked="{Binding MatchCase, Mode=TwoWay}"
                                  ToolTip.Tip="Match case"/>
                    <ToggleButton x:Name="FindWordToggle"
                                  Classes="find-toggle"
                                  Content="Ab"
                                  IsChecked="{Binding WholeWord, Mode=TwoWay}"
                                  ToolTip.Tip="Whole word"/>
                    <ToggleButton x:Name="FindRegexToggle"
                                  Classes="find-toggle"
                                  Content=".*"
                                  IsChecked="{Binding UseRegex, Mode=TwoWay}"
                                  ToolTip.Tip="Use regular expressions"/>
                    <Button x:Name="FindPrevButton"
                            Classes="find-button"
                            Content="▲"
                            Command="{Binding PreviousCommand}"
                            ToolTip.Tip="Previous match (Shift+Enter)"/>
                    <Button x:Name="FindNextButton"
                            Classes="find-button"
                            Content="▼"
                            Command="{Binding NextCommand}"
                            ToolTip.Tip="Next match (Enter)"/>
                    <TextBlock x:Name="FindStatus"
                               Classes="settings-label"
                               VerticalAlignment="Center"
                               Width="74"
                               TextAlignment="Center"
                               Text="{Binding Status}"/>
                    <Button x:Name="FindCloseButton"
                            Classes="find-button"
                            Content="×"
                            Command="{Binding CloseCommand}"
                            ToolTip.Tip="Close (Esc)"/>
                </StackPanel>
            </Border>


            </Grid>

            <StackPanel Grid.Column="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,104,0,0"
                        Spacing="0"
                        IsVisible="{Binding IsStartVisible}">

                <TextBlock Classes="placeholder-title"
                           Text="Start writing"
                           HorizontalAlignment="Center"/>

                <TextBlock Classes="placeholder-body"
                           Margin="0,10,0,20"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="420"
                           Text="A blank page, a typeface you choose, and nothing else in the way. Ctrl+O opens a file, or just begin typing."/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="2">

                    <Button Classes="button-ghost" Content="New"
                            Command="{Binding NewDocumentCommand}"/>

                    <Button Classes="button-ghost" Content="Open…"
                            Command="{Binding OpenCommand}"/>

                </StackPanel>

                <ItemsControl ItemsSource="{Binding RecentFiles}"
                              Margin="0,22,0,0"
                              MaxWidth="440"
                              HorizontalAlignment="Center"
                              IsVisible="{Binding HasRecentFiles}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type system:String}">
                            <Button Classes="recent"
                                    Content="{Binding}"
                                    Command="{Binding $parent[Window].((vm:EditorViewModel)DataContext).OpenRecentCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

                </Grid>

            </Grid>

        <!-- ===== The command palette ======================================
             The one door every command has: type its name, and Enter runs it.
             It floats over the page rather than replacing it, because it is a
             question asked of the editor rather than a place to go. -->
        <views:PaletteView x:Name="Palette"
                           Grid.Row="1"
                           Grid.RowSpan="3"
                           DataContext="{Binding Palette}"
                           IsVisible="{Binding IsOpen}"
                           Focusable="True"/>

        <!-- ===== Status band ===============================================
             Flat grey, matching the format band, so the two read as one
             chrome unit around the sheet. -->
        <Border Grid.Row="3" Classes="editor-status">

            <DockPanel LastChildFill="False">

                <TextBlock Classes="editor-meta"
                           DockPanel.Dock="Left"
                           Text="{Binding StatusMessage}"
                           IsVisible="{Binding HasStatusMessage}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="420"/>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="13"
                            IsVisible="{Binding HasDocument}">

                    <TextBlock Classes="editor-meta"
                               Text="{Binding CaretLine, StringFormat=Ln {0}}"/>
                    <TextBlock Classes="editor-meta"
                               Text="{Binding CaretColumn, StringFormat=Col {0}}"/>
                    <TextBlock Classes="editor-meta"
                               Text="{Binding Encoding}"/>

                    <!-- The line sequence: shown like the rest of the bar,
                         but clickable — the convention is a choice, and the
                         place to make it is beside the place it is shown. -->
                    <Button Classes="status-segment"
                            Content="{Binding Newline}"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Line sequence — click to change">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="LF — line feed (Unix, Linux, macOS)"
                                          ToggleType="Radio"
                                          GroupName="newline"
                                          IsChecked="{Binding NewlineIsLf, Mode=OneWay}"
                                          Command="{Binding SetNewlineCommand}"
                                          CommandParameter="LF"/>
                                <MenuItem Header="CRLF — carriage return + line feed (Windows)"
                                          ToggleType="Radio"
                                          GroupName="newline"
                                          IsChecked="{Binding NewlineIsCrLf, Mode=OneWay}"
                                          Command="{Binding SetNewlineCommand}"
                                          CommandParameter="CRLF"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                    <TextBlock Classes="editor-meta"
                               Text="{Binding Name}"
                               MaxWidth="240"
                               TextTrimming="CharacterEllipsis"/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>

</Window>
