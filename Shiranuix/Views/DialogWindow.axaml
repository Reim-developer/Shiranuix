<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels.Dialogs"
        xmlns:svc="using:Shiranuix.Services.Dialogs"
        x:Class="Shiranuix.Views.DialogWindow"
        x:DataType="vm:DialogContent"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.SurfaceBrush}">

    <!--
        One window for every dialog. The buttons and the answers they give are
        described by the request, so a new kind of dialog is new data and not
        new markup: this window holds no knowledge of what is being asked.
    -->

    <Grid RowDefinitions="Auto,*">

        <!-- The window's own ledge: the request's own title, dragged by, and
             the closing button — an answer comes from the buttons below, not
             from the chrome. -->
        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band"
                WindowDecorationProperties.ElementRole="TitleBar">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="{Binding Title}"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="dialog">
            <StackPanel Spacing="18">

                <TextBlock Classes="dialog-message"
                           Text="{Binding Message}"
                           TextWrapping="Wrap"/>

                <ItemsControl ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:DialogButton">
                            <Button Classes="dialog-button"
                                    Content="{Binding Label}"
                                    Command="{Binding $parent[Window].((vm:DialogContent)DataContext).AnswerCommand}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

        <!-- The frame: one stroke along the window's edge, the theme's own
             line, brighter the while the window holds the eye. -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Classes="frame"
                x:Name="Frame"
                IsHitTestVisible="False"/>

    </Grid>

</Window>
