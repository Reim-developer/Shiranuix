<!--
  The application's settings window.

  One window for every setting, opened from the title band and closed when
  done — modeless, so a theme picked here is the theme on the page behind it,
  live. The rows are bound straight to the state that owns each rule: the
  theme row writes TypographyState.ThemeMode, which stores the choice the
  moment it moves, and the window has nothing to confirm and nothing to save.

  The keyboard section reads KeyBindingState instead — the chords are
  another window's business until they are being pressed for, so its rows
  have their own data context and the one rule no binding carries: a
  capture eating whatever comes until a chord does.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        xmlns:models="using:Shiranuix.Models"
        x:Class="Shiranuix.Views.SettingsWindow"
        x:DataType="vm:TypographyState"
        Title="Settings"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full">

    <Border Classes="settings-body">
        <StackPanel Spacing="16">

            <TextBlock Classes="settings-heading" Text="Appearance"/>

            <Grid ColumnDefinitions="120,*" ColumnSpacing="12">

                <TextBlock Grid.Column="0"
                           Classes="settings-label"
                           Text="Theme"
                           VerticalAlignment="Center"/>

                <ComboBox Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          ItemsSource="{x:Static models:ThemeModes.All}"
                          SelectedItem="{Binding ThemeMode, Mode=TwoWay}"
                          ToolTip.Tip="Applies immediately and is remembered"/>

            </Grid>

            <TextBlock Classes="settings-heading" Text="Keyboard"/>

            <ItemsControl x:Name="KeysList"
                          x:DataType="vm:KeyBindingState"
                          Margin="0,-6,0,0"
                          ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyBindingRow">
                        <Grid ColumnDefinitions="*,130,Auto" ColumnSpacing="8" Margin="0,3">
                            <TextBlock Grid.Column="0"
                                       Classes="settings-label"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Classes="recent"
                                    HorizontalContentAlignment="Center"
                                    Click="OnBindChordClick"
                                    ToolTip.Tip="Click, then press a chord. Escape gives the press back; Delete leaves the command unassigned.">
                                <TextBlock Text="{Binding ChipText}"/>
                            </Button>
                            <Button Grid.Column="2"
                                    Classes="status-segment"
                                    Content="×"
                                    Click="OnClearChordClick"
                                    ToolTip.Tip="Unassign"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The plugins. Read from the folder rather than from the running editor,
             so a plugin that will not load is still listed - and can still be
             got rid of. Turning one off leaves its folder alone; removing it
             deletes the folder, and asks first. Both take effect in the editor
             behind this window.

             The section is one container with its own data context, because
             the list and the empty line below it both read the plugin state
             while the window itself is bound to the typography. -->
            <StackPanel x:Name="PluginsSection"
                        x:DataType="vm:PluginSettingsState">
            <TextBlock Classes="settings-heading" Text="Plugins"/>

            <ItemsControl x:Name="PluginsList"
                          Margin="0,-6,0,0"
                          ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PluginRow">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
                            <StackPanel Grid.Column="0">
                                <TextBlock Classes="settings-label">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="Id"/>
                                            <Binding Path="Version"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Classes="settings-hint"
                                       Text="{Binding StateText}"/>
                            </StackPanel>

                            <!-- The switch is a button rather than a check box because the row already
                                 says what it means in words, and a check box
                                 from Avalonia's own theme is neither this
                                 editor's colour nor its shape. Pressing it
                                 once writes the store and takes a running
                                 plugin out of the editor. -->
                            <Button Grid.Column="1"
                                    Classes="plugin-switch"
                                    Content="{Binding SwitchLabel}"
                                    Command="{Binding EnableCommand}"
                                    ToolTip.Tip="Load this plugin, or stop loading it"/>
                            <Button Grid.Column="2"
                                    Classes="status-segment"
                                    Content="×"
                                    Command="{Binding RemoveCommand}"
                                    ToolTip.Tip="Delete this plugin's folder"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="settings-hint"
                       Margin="0,4,0,0"
                       Text="No plugins installed."
                       IsVisible="{Binding IsEmpty}"/>
            </StackPanel>

            <Button Classes="button-ghost"
                    Content="Reset to defaults"
                    Click="OnResetBindingsClick"
                    HorizontalAlignment="Right"
                    ToolTip.Tip="Every command back on its default chord"/>

        </StackPanel>
    </Border>

</Window>
