<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shiranuix.ViewModels"
             xmlns:models="using:Shiranuix.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="600"
             x:Class="Shiranuix.Views.ReaderView"
             x:DataType="vm:ReaderViewModel">

    <DockPanel>

        <!-- Top toolbar: back, title, reading controls -->
        <Border DockPanel.Dock="Top" Classes="reader-toolbar top">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Content="← Library"
                        Command="{Binding BackCommand}"
                        Classes="button-ghost"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Chapter.Title}"
                           Classes="reader-title"
                           Margin="6,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <ComboBox Grid.Column="2"
                          Width="136"
                          ItemsSource="{x:Static vm:ReaderViewModel.AllDirections}"
                          SelectedItem="{Binding ReadingDirection, Mode=TwoWay}"
                          ToolTip.Tip="Reading direction"/>
                <ComboBox Grid.Column="3"
                          Width="136"
                          ItemsSource="{x:Static vm:ReaderViewModel.AllFitModes}"
                          SelectedItem="{Binding FitMode, Mode=TwoWay}"
                          ToolTip.Tip="Fit mode"/>
            </Grid>
        </Border>

        <!-- Bottom bar: page navigation + seek -->
        <Border DockPanel.Dock="Bottom" Classes="reader-toolbar bottom">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                <Button Grid.Column="0" Content="Previous"
                        Command="{Binding PreviousCommand}"
                        Classes="button-ghost"/>
                <Button Grid.Column="1" Content="Next"
                        Command="{Binding NextCommand}"
                        Classes="button-ghost"/>
                <Slider Grid.Column="2"
                        x:Name="PageSlider"
                        Minimum="1" Value="1"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        Classes="page-slider"/>
                <TextBlock Grid.Column="3"
                           Text="{Binding PageLabel}"
                           Classes="page-label"/>
            </Grid>
        </Border>

        <!-- Centre: the page itself (sized by code-behind via ImageFitting) -->
        <Border Classes="reader-canvas">
            <ScrollViewer x:Name="PageScroller"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center">
                <Image x:Name="PageImage"
                       Source="{Binding CurrentImage}"
                       Stretch="Uniform"
                       StretchDirection="Both"/>
            </ScrollViewer>
        </Border>

    </DockPanel>
</UserControl>
