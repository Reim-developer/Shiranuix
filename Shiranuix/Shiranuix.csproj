<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The release number, in the shape the assembly and any package
         take it. AppVersion in the project carries the same three parts
         for code to compare against; the two move together on release. -->
    <Version>0.1.11</Version>
  </PropertyGroup>

    <ItemGroup>
    <!-- The plugin contract, shared by the editor and by every plugin: one
         assembly, one copy at runtime, so a plugin's IPlugin is the interface
         the editor is holding. -->
    <ProjectReference Include="..\Shiranuix.Plugins\Shiranuix.Plugins.csproj" />
    <ProjectReference Include="..\Shiranuix.Plugins.UI\Shiranuix.Plugins.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- What is inside the editor is not public API, but it is testable: the
         loader and the doors it opens are worth testing without a window. -->
    <InternalsVisibleTo Include="Shiranuix.Tests" />
  </ItemGroup>

  <ItemGroup>
        <!-- Icons: the symbol glyphs the title band's commands are drawn in.
             FASymbolIcon carries its own font inside the package and needs no
             theme include, so nothing about the app's own chrome changes. -->
        <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
        <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency injection: Splat is the app's resolver (Locator.Current),
         Microsoft.Extensions.DependencyInjection is the container behind it,
         and the adapter below binds the two together. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- Persistence: EF Core over SQLite, so the user's settings, recent files
         and font history outlive the session. Design is for the command-line
         migration tools only and never ships in the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Splat" Version="21.0.0" />
    <PackageReference Include="Splat.Microsoft.Extensions.DependencyInjection" Version="21.0.0" />
  </ItemGroup>
</Project>
