<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The doubles the tests build a writing out of: a disk that is not a
         disk, a recent-files store that remembers only what it is told, a
         typography anyone may set. Its own project because both test
         projects need them and neither should hold them hostage - the
         writing's tests and the window's tests are set apart, but they
         argue over the same documents. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Everything here answers an interface this library names. -->
    <ProjectReference Include="..\Shiranuix.CoreEditor\Shiranuix.CoreEditor.csproj" />
    <!-- And the text both sides are made of: the newline the doubles
         detect and the encoding they write with. -->
    <ProjectReference Include="..\Shiranuix.CoreText\Shiranuix.CoreText.csproj" />
  </ItemGroup>

</Project>
