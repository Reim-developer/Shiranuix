<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.Graphs.Dialogs"
        xmlns:chrome="using:Shiranuix.WindowBorderless"
        x:Class="Shiranuix.Graphs.Views.CharacterDialog"
        x:DataType="vm:CharacterDialogViewModel"
        Title="Character information"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.SurfaceBrush}">

    <!--
        A character whole: what they are called, when they were born, what
        the writer says about them, and anything else worth keeping of
        them — which stays beside the canvas rather than on it, and is read
        here.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="Character information"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="dialog">
            <Grid ColumnDefinitions="160,*">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Avatar -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Classes="field-label" Text="Avatar"
                           VerticalAlignment="Center" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="44"
                            Height="44"
                            CornerRadius="22"
                            ClipToBounds="True"
                            Background="{DynamicResource Sx.AccentSoftBrush}"
                            BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Image x:Name="FaceImage" Stretch="UniformToFill"/>
                            <TextBlock x:Name="FaceLetter"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <Button Content="Choose…"
                                Click="OnChooseFace"/>
                        <Button Content="Clear"
                                Classes="button-ghost"
                                Click="OnClearFace"/>
                    </StackPanel>
                </StackPanel>

                <!-- Name -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Classes="field-label" Text="Name"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         x:Name="NameBox" Text="{Binding Name}"/>

                <!-- Day of Birth -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Classes="field-label" Text="Day of birth (optional)"
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                         Text="{Binding BirthDate}"/>

                <!-- Description -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Classes="field-label" Text="Description"
                           VerticalAlignment="Top"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding Description}"
                             MaxLength="100000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"
                             VerticalContentAlignment="Top"/>
                    <TextBlock Classes="field-label"
                               HorizontalAlignment="Right"
                               Text="{Binding DescriptionLength, StringFormat='{}{0} / 100,000'}"/>
                </StackPanel>

                <!-- Special note -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                           Classes="field-label" Text="Special note"
                           VerticalAlignment="Top"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Spacing="4">
                    <TextBox Text="{Binding Note}"
                             MaxLength="50000"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="70"
                             VerticalContentAlignment="Top"/>
                    <TextBlock Classes="field-label"
                               HorizontalAlignment="Right"
                               Text="{Binding NoteLength, StringFormat='{}{0} / 50,000'}"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                           Classes="field-error"
                           Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <!-- Buttons -->
                <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Click="OnCancel"/>
                    <Button Classes="dialog-button"
                            Content="OK"
                            IsDefault="True"
                            Click="OnConfirm"/>
                </StackPanel>
            </Grid>
        </Border>

        <chrome:ChromeFrame Grid.Row="0" Grid.RowSpan="2"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
