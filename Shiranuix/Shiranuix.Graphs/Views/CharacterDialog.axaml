<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.Graphs.Dialogs"
        xmlns:chrome="using:Shiranuix.WindowBorderless"
        x:Class="Shiranuix.Graphs.Views.CharacterDialog"
        x:DataType="vm:CharacterDialogViewModel"
        Title="Character information"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.SurfaceBrush}">

    <!--
        A character whole: what they are called, when they were born, what
        the writer says about them, and anything else worth keeping of
        them — which stays beside the canvas rather than on it, and is read
        here.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="Character information"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="dialog">
            <StackPanel Spacing="18">

                <StackPanel Spacing="6">
                    <TextBlock Classes="field-label" Text="Avatar"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="44"
                                Height="44"
                                CornerRadius="22"
                                ClipToBounds="True"
                                Background="{DynamicResource Sx.AccentSoftBrush}"
                                BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Image x:Name="FaceImage" Stretch="UniformToFill"/>
                                <TextBlock x:Name="FaceLetter"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="4">
                            <Button Content="Choose…"
                                    Click="OnChooseFace"/>
                            <Button Content="Clear"
                                    Classes="button-ghost"
                                    Click="OnClearFace"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="field-label" Text="Name"/>
                    <TextBox x:Name="NameBox" Text="{Binding Name}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="field-label" Text="Day of Birth"/>
                    <TextBox Text="{Binding BirthDate}"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="field-label" Text="Description"/>
                    <TextBox Text="{Binding Description}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="90"
                             VerticalContentAlignment="Top"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Classes="field-label" Text="Special note"/>
                    <TextBox Text="{Binding Note}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="70"
                             VerticalContentAlignment="Top"/>
                </StackPanel>

                <TextBlock Classes="field-error"
                           Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Content="Cancel"
                            IsCancel="True"
                            Click="OnCancel"/>
                    <Button Classes="dialog-button"
                            Content="OK"
                            IsDefault="True"
                            Click="OnConfirm"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <chrome:ChromeFrame Grid.Row="0" Grid.RowSpan="2"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
