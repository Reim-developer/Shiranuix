<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.Graphs"
        xmlns:persistence="using:Shiranuix.Graphs.Persistence"
        xmlns:chrome="using:Shiranuix.WindowBorderless"
        x:Class="Shiranuix.Graphs.Views.WikiWindow"
        x:DataType="vm:WikiState"
        Title="Wiki"
        Width="760"
        MinHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.SurfaceBrush}">

    <!--
        The wiki: the cast of every story, kept once however many maps they
        stand in. The list on the left is who the writer knows; the form on
        the right is what the writer knows about the one they have chosen.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="Wiki"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="260,*">

            <!-- Who the writer knows: the characters, by name. -->
            <Border Grid.Column="0" Classes="dialog" Margin="12,12,0,12">
                <DockPanel LastChildFill="True">

                    <TextBlock DockPanel.Dock="Top"
                               Classes="field-label"
                               Text="Characters"
                               Margin="0,0,0,8"/>

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button Content="New"
                                Classes="button-ghost"
                                Command="{Binding NewCharacterCommand}"/>
                    </StackPanel>

                    <Grid>
                        <ListBox ItemsSource="{Binding Characters}"
                                 SelectedItem="{Binding Selected}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="persistence:WikiCharacterRow">
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock Classes="field-label"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- A wiki with nobody in it says so, rather than
                             standing as an empty box. -->
                        <TextBlock Text="No characters yet — create one."
                                   Classes="field-label"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding IsEmpty}"/>
                    </Grid>

                </DockPanel>
            </Border>

<!-- What the writer knows about the one they have chosen. -->
            <Border Grid.Column="1" Classes="dialog" Margin="12">
                <ScrollViewer>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                        <!-- Avatar -->
                        <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="field-label" Text="Avatar" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1" HorizontalAlignment="Left">
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Sx.AccentSoftBrush}"
                                        BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="FaceImage" Stretch="UniformToFill"/>
                                        <TextBlock x:Name="FaceLetter"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Button Content="Choose…"
                                            Click="OnChooseFace"/>
                                    <Button Content="Clear"
                                            Classes="button-ghost"
                                            Click="OnClearFace"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Name -->
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Classes="field-label" Text="Name" VerticalAlignment="Center" MinWidth="100"/>
                            <TextBox Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Day of Birth -->
                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Classes="field-label" Text="Day of Birth" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding BirthDate}" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Description -->
                        <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Classes="field-label" Text="Description" VerticalAlignment="Top" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Description}"
                                     MaxLength="100000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="110"
                                     VerticalContentAlignment="Top"
                                     Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="field-label" HorizontalAlignment="Right" Margin="8,4,0,0"
                                       Text="{Binding DescriptionLength, StringFormat='{}{0} / 100,000'}"/>
                        </Grid>

                        <!-- Special note -->
                        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,8,0,0">
                            <TextBlock Grid.Column="0" Classes="field-label" Text="Special note" VerticalAlignment="Top" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1" Text="{Binding Note}"
                                     MaxLength="50000"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Height="80"
                                     VerticalContentAlignment="Top"
                                     Margin="8,0,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="field-label" HorizontalAlignment="Right" Margin="8,4,0,0"
                                       Text="{Binding NoteLength, StringFormat='{}{0} / 50,000'}"/>
                        </Grid>

                        <!-- Error -->
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Classes="field-error" Text="{Binding Error}"
                                   IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                   Margin="0,8,0,0"/>

                        <!-- Buttons -->
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
                            <Button Content="Delete"
                                    Classes="button-ghost"
                                    Command="{Binding DeleteCommand}"/>
                            <Button Content="Save"
                                    Classes="dialog-button"
                                    Command="{Binding SaveCommand}"/>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Border>

        </Grid>

        <chrome:ChromeFrame Grid.Row="0" Grid.RowSpan="2"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
