<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.Graphs"
        xmlns:persistence="using:Shiranuix.Graphs.Persistence"
        xmlns:chrome="using:Shiranuix.WindowBorderless"
        x:Class="Shiranuix.Graphs.Views.WikiWindow"
        x:DataType="vm:WikiState"
        Title="Wiki"
        Width="760"
        MinHeight="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.SurfaceBrush}">

    <!--
        The wiki: the cast of every story, kept once however many maps they
        stand in. The list on the left is who the writer knows; the form on
        the right is what the writer knows about the one they have chosen.

        Both panels are DockPanels with their footers pinned to the bottom
        edge, so however tall either column is the two always share a floor:
        the footer of the right panel — special note and the buttons — sits
        level with the bottom of the characters' table on the left.
    -->

    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="Wiki"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="260,*">

            <!-- Who the writer knows: the characters, by name. -->
            <Border Grid.Column="0" Classes="dialog" Margin="12">
                <DockPanel LastChildFill="True">

                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="8"
                                Margin="0,10,0,0">
                        <Button ToolTip.Tip="New character"
                                AutomationProperties.Name="New character"
                                Classes="tool"
                                Command="{Binding NewCharacterCommand}">
                            <LucideIcon Classes="tool-icon" Kind="UserPlus"/>
                        </Button>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Top"
                               Classes="field-label"
                               Text="Characters"
                               Margin="0,0,0,8"/>

                    <!-- The table of names, pulled a floor of its own but
                         never taller than the room allows: past the cap it
                         scrolls inside itself rather than stretching the
                         window. -->
                    <Grid>
                        <ListBox ItemsSource="{Binding Characters}"
                                 SelectedItem="{Binding Selected}"
                                 MaxHeight="340"
                                 BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Sx.BorderSoftBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:hover /template/ Border#PART_ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource Sx.SurfaceHoverBrush}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="persistence:WikiCharacterRow">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1"
                                                   Classes="field-label"
                                                   Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="12,0,0,0"
                                                   MaxWidth="150"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- A wiki with nobody in it says so, rather than
                             standing as an empty box. -->
                        <TextBlock IsVisible="{Binding IsEmpty}"
                                   Text="No characters yet — create one."
                                   Classes="field-label"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>

                </DockPanel>
            </Border>

            <!-- What the writer knows about the one they have chosen. -->
            <Border Grid.Column="1" Classes="dialog" Margin="12">
                <DockPanel LastChildFill="True">

                    <!-- The special note and the buttons stand on the floor
                         of this panel, level with the characters' table. -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,14,0,0">
                        <!-- The note stands in the very frame the description
                             does — the same hundred-pixel label column, the
                             same eight pixels of gutter — so the two boxes
                             are the same box twice, exactly as wide as one
                             another however the labels beside them measure. -->
                        <Grid ColumnDefinitions="100,*">
                            <TextBlock Grid.Column="0"
                                       Classes="field-label" Text="Special note"
                                       VerticalAlignment="Top"
                                       Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                <TextBox Text="{Binding Note}"
                                         MaxLength="50000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="110"
                                         VerticalContentAlignment="Top"/>
                                <TextBlock Classes="field-label"
                                           HorizontalAlignment="Right"
                                           Text="{Binding NoteLength, StringFormat='{}{0} / 50,000'}"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Spacing="8"
                                    Margin="0,10,0,0">
                            <Button ToolTip.Tip="Delete character"
                                    AutomationProperties.Name="Delete character"
                                    Classes="tool"
                                    Command="{Binding DeleteCommand}">
                                <LucideIcon Classes="tool-icon" Kind="Trash"/>
                            </Button>
                            <Button ToolTip.Tip="Save character"
                                    AutomationProperties.Name="Save character"
                                    Classes="tool"
                                    Command="{Binding SaveCommand}">
                                <LucideIcon Classes="tool-icon" Kind="Save"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Scrollable form fields: the fact card, ruled. -->
                    <ScrollViewer>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto">

                            <!-- Avatar -->
                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Classes="field-label" Text="Avatar"
                                       VerticalAlignment="Center" Margin="0,0,0,12"/>
                            <StackPanel Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal" Spacing="8"
                                        VerticalAlignment="Center" Margin="8,0,0,0">
                                <Border Width="44"
                                        Height="44"
                                        CornerRadius="22"
                                        ClipToBounds="True"
                                        Background="{DynamicResource Sx.AccentSoftBrush}"
                                        BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Image x:Name="FaceImage" Stretch="UniformToFill"/>
                                        <TextBlock x:Name="FaceLetter"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                                <Button Classes="tool"
                                        ToolTip.Tip="Choose a picture"
                                        AutomationProperties.Name="Choose a picture"
                                        Click="OnChooseFace">
                                    <LucideIcon Classes="tool-icon" Kind="Image"/>
                                </Button>
                                <Button Classes="tool"
                                        ToolTip.Tip="Clear the picture"
                                        AutomationProperties.Name="Clear the picture"
                                        Click="OnClearFace">
                                    <LucideIcon Classes="tool-icon" Kind="X"/>
                                </Button>
                            </StackPanel>

                            <!-- Name -->
                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Classes="field-label" Text="Name"
                                       VerticalAlignment="Center" MinWidth="100" Margin="0,8,0,0"/>
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding Name}" Margin="8,8,0,0"/>

                            <!-- Day of Birth -->
                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Classes="field-label" Text="Day of Birth"
                                       VerticalAlignment="Center" Margin="0,8,12,0"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding BirthDate}" Margin="8,8,0,0"/>

                            <!-- Description -->
                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Classes="field-label" Text="Description"
                                       VerticalAlignment="Top" Margin="0,8,12,0"/>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4" Margin="8,8,0,0">
                                <TextBox Text="{Binding Description}"
                                         MaxLength="100000"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         Height="110"
                                         VerticalContentAlignment="Top"/>
                                <TextBlock Classes="field-label"
                                           HorizontalAlignment="Right"
                                           Text="{Binding DescriptionLength, StringFormat='{}{0} / 100,000'}"/>
                            </StackPanel>

                            <!-- Error -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                       Classes="field-error" Text="{Binding Error}"
                                       IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                                       Margin="0,8,0,0"/>

                        </Grid>
                    </ScrollViewer>

                </DockPanel>
            </Border>

        </Grid>

        <chrome:ChromeFrame Grid.Row="0" Grid.RowSpan="2"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
