<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.Graphs"
        xmlns:persistence="using:Shiranuix.Graphs.Persistence"
        xmlns:chrome="using:Shiranuix.WindowBorderless"
        x:Class="Shiranuix.Graphs.Views.GraphWindow"
        x:DataType="vm:GraphState"
        Title="Character relationships"
        Width="980"
        Height="720"
        MinWidth="640"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.CanvasBrush}">

    <!--
        The relationship map, standing beside the writing: a band that names
        it, a band of what may be done to it, and the paper itself. The
        paper takes the whole window below the bands — a graph needs room
        more than it needs chrome — and the map says nothing of itself
        once there is a graph to read.
    -->

    <Grid RowDefinitions="Auto,Auto,*">

        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="Character relationships"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionMin"
                            Classes="caption"
                            Focusable="False"
                            ToolTip.Tip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <LucideIcon Classes="caption-icon" Kind="Minus"/>
                    </Button>
                    <Button x:Name="CaptionMax"
                            Classes="caption"
                            Focusable="False"
                            ToolTip.Tip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <LucideIcon Classes="caption-icon" Kind="Square"/>
                    </Button>
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            Focusable="False"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="format-bar">
            <StackPanel Orientation="Horizontal"
                        Spacing="6">

                <!-- Which graph stands open: the picker says every graph the
                     writer keeps, and turning it turns the whole paper. -->
                <ComboBox Width="190"
                          Classes="field"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Graphs}"
                          SelectedItem="{Binding CurrentGraph}"
                          ToolTip.Tip="The graph standing open">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="persistence:GraphSummary">
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Button Classes="tool"
                        Command="{Binding NewGraphCommand}"
                        ToolTip.Tip="New graph"
                        AutomationProperties.Name="New graph">
                    <LucideIcon Classes="tool-icon" Kind="FilePlus"/>
                </Button>
                <Button Classes="tool"
                        Command="{Binding RenameGraphCommand}"
                        ToolTip.Tip="Rename graph"
                        AutomationProperties.Name="Rename graph">
                    <LucideIcon Classes="tool-icon" Kind="PencilLine"/>
                </Button>
                <Button Classes="tool"
                        Command="{Binding DeleteGraphCommand}"
                        ToolTip.Tip="Delete graph"
                        AutomationProperties.Name="Delete graph">
                    <LucideIcon Classes="tool-icon" Kind="Trash"/>
                </Button>

                <Border Classes="doc-sep"/>

                <Button Classes="tool"
                        Command="{Binding AddCharacterCommand}"
                        ToolTip.Tip="Add character"
                        AutomationProperties.Name="Add character">
                    <LucideIcon Classes="tool-icon" Kind="UserPlus"/>
                </Button>
                <Button Classes="tool"
                        Command="{Binding OpenWikiCommand}"
                        ToolTip.Tip="Wiki"
                        AutomationProperties.Name="Wiki">
                    <LucideIcon Classes="tool-icon" Kind="BookOpen"/>
                </Button>
                <Button Classes="tool"
                        Command="{Binding AddRelationshipCommand}"
                        ToolTip.Tip="Draw a relationship between two characters"
                        AutomationProperties.Name="Add relationship">
                    <LucideIcon Classes="tool-icon" Kind="Link"/>
                </Button>
                <Button Classes="tool"
                        Command="{Binding EditCommand}"
                        ToolTip.Tip="Edit the selection — double-click does this too"
                        AutomationProperties.Name="Edit">
                    <LucideIcon Classes="tool-icon" Kind="Pencil"/>
                </Button>
                <Button Classes="tool"
                        Command="{Binding DeleteSelectionCommand}"
                        ToolTip.Tip="Delete the selection — the Delete key does this too"
                        AutomationProperties.Name="Delete">
                    <LucideIcon Classes="tool-icon" Kind="Trash"/>
                </Button>

                <Border Classes="doc-sep"/>

                <Button Classes="tool"
                        Command="{Binding RelayoutCommand}"
                        ToolTip.Tip="Arrange the graph"
                        AutomationProperties.Name="Arrange">
                    <LucideIcon Classes="tool-icon" Kind="RefreshCw"/>
                </Button>

            </StackPanel>
        </Border>

        <Grid Grid.Row="2">
            <vm:GraphCanvas x:Name="GraphPane"/>

            <!-- A tie's words rewritten where they stand: the box opens
                 over the very pill it is changing, so the line never
                 leaves the eye while it is being told what to say. Enter
                 takes the words, Escape throws them away, and a press
                 anywhere else takes them too. -->
            <TextBox x:Name="WordsEdit"
                     IsVisible="False"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Top"
                     FontSize="11"
                     TextWrapping="NoWrap"/>

            <!-- What the writer knows about the character the hand is
                 resting on: the face they wear on the left, and their
                 account on the right — a table of its own, ruled with the
                 thinnest line the paper will take, so that the writing
                 reads as a list of facts rather than a paragraph. -->
            <Border x:Name="CharacterCard"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Width="300"
                    CornerRadius="6"
                    Background="{DynamicResource Sx.SurfaceHoverBrush}"
                    BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="Auto,*">

                    <!-- The face: the picture the writer chose, or the first
                         letter of their name where there is no picture. -->
                    <Border Grid.Column="0"
                            Width="56"
                            Height="56"
                            Margin="12"
                            CornerRadius="28"
                            ClipToBounds="True"
                            Background="{DynamicResource Sx.AccentSoftBrush}"
                            BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Image x:Name="CardFace" Stretch="UniformToFill"/>
                            <TextBlock x:Name="CardInitial"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                        </Grid>
                    </Border>

                    <!-- The account: four rows, each ruled with the
                         thinnest line the paper will take. -->
                    <Grid Grid.Column="1"
                          Margin="0,10,14,10"
                          RowDefinitions="Auto,Auto,Auto,Auto">

                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                BorderThickness="0,0,0,0.5"
                                Padding="0,0,0,5">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="field-label"
                                           Text="Name"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="CardName"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1"
                                BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                BorderThickness="0,0,0,0.5"
                                Padding="0,5,0,5">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="field-label"
                                           Text="Day of Birth"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="CardBirthDate"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource Sx.BorderSoftBrush}"
                                BorderThickness="0,0,0,0.5"
                                Padding="0,5,0,5">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="field-label"
                                           Text="Description"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="CardDescription"
                                           TextWrapping="Wrap"
                                           MaxLines="3"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="3" Padding="0,5,0,0">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Classes="field-label"
                                           Text="Special note"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Top"/>
                                <TextBlock Grid.Column="1"
                                           x:Name="CardNote"
                                           TextWrapping="Wrap"
                                           MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

        <chrome:ChromeFrame Grid.Row="0" Grid.RowSpan="3"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
