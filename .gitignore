# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio / VS Code / Rider
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.iml
.vscode/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# The repository's own Packages folder is source, not a restore folder:
# the two shared projects standing there let their files past the pattern
# above, while their build outputs fall under the same names the head of
# this file already keeps out.
!/Packages/**
/Packages/**/[Bb]in/
/Packages/**/[Oo]bj/
/Packages/**/[Oo]ut/

# Test results & coverage
[Tt]est[Rr]esults/
*.trx
coverage*.json
coverage*.xml
*.coverage
*.coveragexml

# Publish output
publish/
# The smoke's own published file, where CI drops it and where a machine
# reproducing CI's steps locally would drop it beside the repository.
smoke/
smoke-local/
*.pubxml
*.pubxml.user

# Avalonia / misc
*.log

# OS junk
.DS_Store
Thumbs.db

# Python bytecode caches: the measuring tool is run, not shipped
__pycache__/
*.pyc
