<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The headless platform, and the xunit glue over it: the windows in
         this suite are shown on Avalonia's own headless engine — no
         display, the real input pipeline — and the glue is built on xunit
         v3's extensibility, which is why the framework below is v3 rather
         than v2. The version is the one the glue was built against. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <!-- The runner the repository already keeps: one adapter, capable of
         v1, v2 and v3 alike, so the day the other test project follows it
         over, no runner moves. -->
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Narika\Narika.csproj" />
  </ItemGroup>

</Project>
