<!--
  Narika application root: the launcher and the installer, dressed the
  editor's way.

  Three ingredients, the same three the editor's root carries:

  * FluentTheme.Palettes retunes Fluent's base palette for light and dark —
    cream surfaces and the warm rose accent in light, the cold gray ramp and
    the steel blue accent in dark — the block the editor's App.axaml
    carries. The two are kept in step by hand: this is the one place the
    two applications may drift, and the comment is the reminder not to.
  * Packages/Shiranuix.Theme (loaded into Application.Resources) overrides a
    few Fluent keys and defines the repository's own `Sx.*` tokens — the
    surfaces, the borders, the frame's two lights — so every window here
    names exactly the colours every window there names.
  * Packages/Shiranuix.WindowBorderless carries the drawn chrome — the
    frame, the ledge and the three caption buttons — that both windows
    below draw for themselves; Narika/Styles.axaml holds the small rules
    of its own, built on the same tokens.

  The theme toggle in the launcher walks System, Light and Dark over this
  whole stack, which is what makes the two faces of the two applications
  the same two faces.

  The wizard itself is one room with five furnishings: every page's view
  model is mapped to its view below, so the window's one content control
  shows whichever page the walk has reached by naming it alone.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             xmlns:views="using:Narika.Views.Pages"
             xmlns:pages="using:Narika.ViewModels.Pages"
             x:Class="Narika.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Light: cream surfaces, warm plum text, rose accent —
                     the editor's own, verbatim. -->
                <fluent:ColorPaletteResources x:Key="Light"
                                              Accent="#FFC6445E"
                                              RegionColor="#FFFFF9F5"
                                              AltHigh="#FFFCF8F6"
                                              AltMediumHigh="#CCFCF8F6"
                                              AltMedium="#99FCF8F6"
                                              AltMediumLow="#66FCF8F6"
                                              AltLow="#33FCF8F6"
                                              BaseHigh="#FF3D2E33"
                                              BaseMediumHigh="#CC3D2E33"
                                              BaseMedium="#993D2E33"
                                              BaseMediumLow="#663D2E33"
                                              BaseLow="#333D2E33"
                                              ListLow="#193D2E33"
                                              ListMedium="#333D2E33"
                                              ChromeAltLow="#FF33252A"
                                              ChromeHigh="#FFDCCCCA"
                                              ChromeLow="#FFF5EDEB"
                                              ChromeMedium="#FFEEE2E0"
                                              ChromeMediumLow="#FFF3E9E7"
                                              ChromeGray="#FF8E7577"
                                              ChromeDisabledHigh="#FFDCCCCA"
                                              ChromeDisabledLow="#FF96807F"
                                              ErrorText="#FFC0392B"/>
                <!-- Dark: the cold gray ramp instead of warm plum, the
                     steel blue accent instead of the rose — the editor's
                     own, verbatim, so both faces stay one house. -->
                <fluent:ColorPaletteResources x:Key="Dark"
                                              Accent="#FF4C8DFF"
                                              RegionColor="#FF1E1F22"
                                              AltHigh="#FF26282C"
                                              AltMediumHigh="#CC26282C"
                                              AltMedium="#9926282C"
                                              AltMediumLow="#6626282C"
                                              AltLow="#3326282C"
                                              BaseHigh="#FFE0E2E5"
                                              BaseMediumHigh="#CCE0E2E5"
                                              BaseMedium="#99E0E2E5"
                                              BaseMediumLow="#66E0E2E5"
                                              BaseLow="#33E0E2E5"
                                              ListLow="#19E0E2E5"
                                              ListMedium="#33E0E2E5"
                                              ChromeAltLow="#FF313338"
                                              ChromeHigh="#FF4E5058"
                                              ChromeLow="#FF232428"
                                              ChromeMedium="#FF2B2D31"
                                              ChromeMediumLow="#FF2E3035"
                                              ChromeGray="#FF949BA4"
                                              ChromeDisabledHigh="#FF4E5058"
                                              ChromeDisabledLow="#FF7C8188"
                                              ErrorText="#FFF0897A"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Shiranuix.WindowBorderless/Styles.axaml"/>
        <StyleInclude Source="avares://Narika/Styles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Shiranuix.Theme/Palette.axaml"/>
                <ResourceInclude Source="avares://Shiranuix.WindowBorderless/ChromeResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type pages:WelcomePageViewModel}">
            <views:WelcomePage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:DestinationPageViewModel}">
            <views:DestinationPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:OptionsPageViewModel}">
            <views:OptionsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:ProgressPageViewModel}">
            <views:ProgressPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type pages:FinishPageViewModel}">
            <views:FinishPage />
        </DataTemplate>
    </Application.DataTemplates>
</Application>
