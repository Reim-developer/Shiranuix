<!--
  The installer's one window, and the shape every installer has: a page
  that changes in the room above, and the three buttons that walk it in a
  bar below.

  Fixed size and not resizable, because a setup is a sequence rather than
  a workspace: it is read once, walked once, and closed — there is nothing
  on any page that rewards a larger window.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Narika.ViewModels"
        x:Class="Narika.MainWindow"
        x:DataType="vm:InstallerViewModel"
        Title="Narika — Shiranuix Setup"
        Width="560"
        Height="420"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        FontSize="13">
    <Grid RowDefinitions="*,Auto">
        <ContentControl Grid.Row="0"
                        Content="{Binding CurrentPage}"
                        Margin="26,22,26,8" />
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="16,12,16,14">
            <Grid ColumnDefinitions="*,Auto">
                <Button Grid.Column="0"
                        Content="Back"
                        Command="{Binding BackCommand}"
                        MinWidth="92" />
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="10">
                    <Button Content="{Binding NextContent}"
                            Command="{Binding NextCommand}"
                            Classes="accent"
                            MinWidth="92" />
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            MinWidth="92" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
