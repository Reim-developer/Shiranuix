<!--
  The wizard's opening page: one heading, one line under it, and nothing
  that asks a question — a setup's first screen should be read, not
  answered.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Narika.ViewModels.Pages"
             x:Class="Narika.Views.Pages.WelcomePage"
             x:DataType="pages:WelcomePageViewModel">
    <StackPanel Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Welcome to Shiranuix Setup"
                   FontSize="21"
                   FontWeight="SemiBold" />
        <TextBlock Text="{Binding VersionLine}"
                   FontSize="13.5"
                   TextWrapping="Wrap" />
        <TextBlock Text="Click Next to continue, or Cancel to leave this window without installing anything."
                   FontSize="13"
                   Opacity="0.7"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
