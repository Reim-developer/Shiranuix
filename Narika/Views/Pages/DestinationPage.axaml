<!--
  The folder page, and the walk's first: the version setup is walking
  through says itself on the heading's own line, and the line being
  edited below it is the whole question here — the picker beside it is
  for a person who would rather point than type.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:Narika.ViewModels.Pages"
             x:Class="Narika.Views.Pages.DestinationPage"
             x:DataType="pages:DestinationPageViewModel">
    <StackPanel Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="Choose where Shiranuix will be installed"
                   FontSize="16"
                   FontWeight="SemiBold" />
        <TextBlock FontSize="13"
                   TextWrapping="Wrap">
            <Run Text="{Binding IntroLine}" />
            <Run Text="You may type a path or pick one — it may not exist yet; setup makes it." />
        </TextBlock>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0"
                     Text="{Binding DestinationPath}"
                     PlaceholderText="C:\Users\you\AppData\Local\Programs\Shiranuix" />
            <Button Grid.Column="1"
                    Command="{Binding BrowseCommand}"
                    MinWidth="88">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="glyph" Text="&#xE8B7;" />
                    <TextBlock Text="Browse..." />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock Text="A shortcut on the desktop or in the start menu is asked for on the next screen."
                   FontSize="12.5"
                   Opacity="0.7"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
