<!--
  Narika application styles.

  Small on purpose: two habits the whole launcher and wizard share, and
  nothing else. Everything else is the shared palette's own — the house's
  Sx.* tokens and Fluent's rose face, both loaded at the application root.
  The rules below use classes (`.glyph`, `.badge`), which are style
  *triggers* of a higher priority than the plain setters inside Fluent's
  control themes, so these win where they meet without retuning any
  palette of their own.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Glyph =================================================== -->

    <!--
        Every symbol the buttons carry: Segoe Fluent Icons on the machines
        that have it, Segoe MDL2 Assets on the older ones — the same
        codepoints answer to both names, and the label beside the glyph
        keeps the meaning when neither font does.
    -->
    <Style Selector="TextBlock.glyph">
        <Setter Property="FontFamily"
                Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Badge =================================================== -->

    <!-- The quiet pill beside the application's name: what install state
         says, drawn as a hairline outline rather than a fill so it reads
         as a note about the card rather than part of its controls. -->
    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource Sx.BorderSoftBrush}" />
    </Style>
</Styles>
