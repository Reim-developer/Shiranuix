<!--
  Narika's one window, and nothing in it.

  The stock decorations and the system's own title bar: this window owes
  nobody a demonstration of anything yet, so it stands the ordinary way,
  with the shape every other window on the machine has.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Narika.MainWindow"
        Title="Narika"
        Width="800" Height="450">
</Window>
