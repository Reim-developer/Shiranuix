<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Not versioned here yet: Narika does not ride the editor's release
         train, and the day it does, it gets its own number moved by its
         own workflow beside it. -->
    <!-- The test project lives inside this package folder, beside the
         app it tests: the SDK's default globs must walk past it, or its
         sources — and its generated obj files — would be compiled into
         the application along with this project's own. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Narika.Tests\**</DefaultItemExcludes>
    <!-- Narika's own mark: a white toolbox over "Na" on a violet gradient,
         in the Visual Studio Installer's idea — a name and the thing it
         installs. It is the launcher's taskbar and title bar, and the card
         keeps the editor's picture below. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Narika's own mark, embedded for the window and the taskbar. -->
    <AvaloniaResource Include="Assets\app-64.png" Link="Assets\narika-64.png" />
    <!-- The editor's picture, linked rather than copied: the launcher's one
         card shows the very file the editor ships its window icon from, so
         the two can never drift a pixel apart. It lands under this
         project's own Assets folder under the name that says whose it is,
         which is the avares path the card binds it by. -->
    <AvaloniaResource Include="..\Shiranux\Shiranuix\Assets\app-64.png" Link="Assets\shiranuix-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lucide: the icon set the caption glyphs are named from — the
         ledge's minimize, fill and close, borrowed from the same package
         the editor's windows read theirs from. -->
    <PackageReference Include="Lucide.Avalonia" Version="0.2.26" />
    <!-- The same three the editor stands on: the desktop engine, the stock
         Fluent theme with no palette of its own yet, and the one font the
         interface needs before Narika has any opinions of its own. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- The same view model machinery the editor keeps: compiled observable
         properties and commands over an empty base. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency injection, wired the editor's way: Splat is the resolver,
         Microsoft.Extensions.DependencyInjection is the container behind it,
         and the adapter below binds the two together. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Splat" Version="21.0.0" />
    <PackageReference Include="Splat.Microsoft.Extensions.DependencyInjection" Version="21.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository's two rooms of shared UI, the editor draws from and
         Narika now draws from too: the palette every surface, border and
         glyph is named from, and the drawn chrome — frame, ledge and
         caption buttons — the windows below wear. -->
    <ProjectReference Include="..\Packages\Shiranuix.Theme\Shiranuix.Theme.csproj" />
    <ProjectReference Include="..\Packages\Shiranuix.WindowBorderless\Shiranuix.WindowBorderless.csproj" />
  </ItemGroup>
</Project>
