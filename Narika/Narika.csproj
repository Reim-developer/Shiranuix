<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- An empty window, standing ready: nothing is promised to anyone yet,
         so no number is said here. The day Narika ships, it gets its own
         version, moved by its own release train beside the editor's. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The same three the editor stands on: the desktop engine, the stock
         Fluent theme with no palette of its own yet, and the one font the
         interface needs before Narika has any opinions of its own. -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- The same view model machinery the editor keeps: compiled observable
         properties and commands over an empty base. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency injection, wired the editor's way: Splat is the resolver,
         Microsoft.Extensions.DependencyInjection is the container behind it,
         and the adapter below binds the two together. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Splat" Version="21.0.0" />
    <PackageReference Include="Splat.Microsoft.Extensions.DependencyInjection" Version="21.0.0" />
  </ItemGroup>
</Project>
