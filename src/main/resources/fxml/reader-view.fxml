<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Reader screen: a full-bleed page viewport in the centre, a translucent
  toolbar on top (back, title, reading controls), and a bottom bar with page
  navigation and a seek slider. The page viewport itself is added
  programmatically by the controller (PageCanvas), because its layout maths
  is code, not declarations.
-->
<BorderPane fx:id="root"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.reim.shiranuix.ui.reader.ReaderController"
            styleClass="root">

    <!-- Top toolbar -->
    <top>
        <VBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="reader-toolbar">
                <Button fx:id="backButton" text="← Library"/>
                <Label fx:id="titleLabel" text="" styleClass="app-title" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="directionComboBox"/>
                <ComboBox fx:id="fitModeComboBox"/>
                <Button fx:id="themeButton" text="Theme"/>
            </HBox>
        </VBox>
    </top>

    <!-- Centre: page viewport is inserted here by the controller -->
    <center>
        <StackPane fx:id="viewport" styleClass="reader-canvas"/>
    </center>

    <!-- Bottom navigation bar -->
    <bottom>
        <HBox spacing="12" alignment="CENTER" styleClass="reader-toolbar">
            <Button fx:id="previousButton" text="Previous"/>
            <Slider fx:id="pageSlider" majorTickUnit="1" minorTickCount="0"
                    blockIncrement="1" HBox.hgrow="ALWAYS" styleClass="page-slider"/>
            <Button fx:id="nextButton" text="Next"/>
            <Label fx:id="pageLabel" text="– / –"/>
            <Button fx:id="fullscreenButton" text="Fullscreen"/>
        </HBox>
    </bottom>
</BorderPane>
