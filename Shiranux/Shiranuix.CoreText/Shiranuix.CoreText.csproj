<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The one place a line break and an encoding are answered for: what a
         newline is written as, which convention a writing arrived in, and
         the UTF-8 every plain file is read and written with. The lowest
         library here - it stands on .NET alone, because every other
         library and the app ask these questions and none of them may
         spell the answer for itself. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
