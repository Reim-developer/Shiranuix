<!--
  Shiranuix application root.

  Three ingredients define the look:

  * FluentTheme.Palettes retunes Fluent's base palette (accent, region and
    the Alt/Base/Chrome/List colour ramps) for light and dark. The accent is
    a warm rose in light over cream; dark sets both aside for a cold gray
    ramp with a steel blue accent — the same two faces Narika wears. It
    styles the stock controls — the window itself paints Sx.CanvasBrush, the
    desk the document sheet sits on, which differs from the sheet's white or
    cold gray enough to read as a separate surface. The same block, kept in
    step by hand, is what Narika loads so the two applications read as one
    house.
  * Packages/Shiranuix.Theme (loaded into Application.Resources) overrides a
    few Fluent keys and defines the app's own `Sx.*` tokens. Application
    resources are searched before Application styles, so these win over the
    theme's values.
  * Styles.axaml holds the app-wide control styling built on those tokens,
    and Packages/Shiranuix.WindowBorderless carries the drawn chrome — the
    frame, the ledge and the three caption buttons — every window here
    draws for itself.

  The interface is drawn in the platform's default typeface, registered at
  startup; the document's typeface is the user's choice and never a token.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="Shiranuix.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Light: cream surfaces, warm plum text, rose accent. -->
                <fluent:ColorPaletteResources x:Key="Light"
                                              Accent="#FFC6445E"
                                              RegionColor="#FFFFF9F5"
                                              AltHigh="#FFFCF8F6"
                                              AltMediumHigh="#CCFCF8F6"
                                              AltMedium="#99FCF8F6"
                                              AltMediumLow="#66FCF8F6"
                                              AltLow="#33FCF8F6"
                                              BaseHigh="#FF3D2E33"
                                              BaseMediumHigh="#CC3D2E33"
                                              BaseMedium="#993D2E33"
                                              BaseMediumLow="#663D2E33"
                                              BaseLow="#333D2E33"
                                              ListLow="#193D2E33"
                                              ListMedium="#333D2E33"
                                              ChromeAltLow="#FF33252A"
                                              ChromeHigh="#FFDCCCCA"
                                              ChromeLow="#FFF5EDEB"
                                              ChromeMedium="#FFEEE2E0"
                                              ChromeMediumLow="#FFF3E9E7"
                                              ChromeGray="#FF8E7577"
                                              ChromeDisabledHigh="#FFDCCCCA"
                                              ChromeDisabledLow="#FF96807F"
                                              ErrorText="#FFC0392B"/>
                <!-- Dark: the cold gray ramp instead of warm plum, the
                     steel blue accent instead of the rose — the editor's
                     own, verbatim, so both faces stay one house. -->
                <fluent:ColorPaletteResources x:Key="Dark"
                                              Accent="#FF4C8DFF"
                                              RegionColor="#FF1E1F22"
                                              AltHigh="#FF26282C"
                                              AltMediumHigh="#CC26282C"
                                              AltMedium="#9926282C"
                                              AltMediumLow="#6626282C"
                                              AltLow="#3326282C"
                                              BaseHigh="#FFE0E2E5"
                                              BaseMediumHigh="#CCE0E2E5"
                                              BaseMedium="#99E0E2E5"
                                              BaseMediumLow="#66E0E2E5"
                                              BaseLow="#33E0E2E5"
                                              ListLow="#19E0E2E5"
                                              ListMedium="#33E0E2E5"
                                              ChromeAltLow="#FF313338"
                                              ChromeHigh="#FF4E5058"
                                              ChromeLow="#FF232428"
                                              ChromeMedium="#FF2B2D31"
                                              ChromeMediumLow="#FF2E3035"
                                              ChromeGray="#FF949BA4"
                                              ChromeDisabledHigh="#FF4E5058"
                                              ChromeDisabledLow="#FF7C8188"
                                              ErrorText="#FFF0897A"/>
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Shiranuix/Styles.axaml"/>
        <StyleInclude Source="avares://Shiranuix.WindowBorderless/Styles.axaml"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Shiranuix.Theme/Palette.axaml"/>
                <ResourceInclude Source="avares://Shiranuix.WindowBorderless/ChromeResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
