<!--
  The window that says what went wrong.

  Shown by the crash guard at the moment something throws that nobody
  caught: one line about what happened, a code the reader can quote, and
  the file the whole story was written into. It is built by hand rather
  than through the container — at crash time the machinery worth trusting
  least is the machinery — so everything it needs arrives through its
  constructor, and it leans on nothing but the application's own theme,
  which was loaded long before it.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Shiranuix.WindowBorderless"
        x:Class="Shiranuix.Views.CrashDialog"
        Title="Unexpected error"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="{DynamicResource Sx.SurfaceBrush}">

    <Grid RowDefinitions="Auto,*">

        <!-- The window's own ledge: the one line a window of this kind keeps
             for itself, and only the closing button beside it — a crash's
             verdict is answered by the buttons below, not by the chrome. -->
        <Border Grid.Row="0" x:Name="TitleBand" Classes="window-band">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Classes="window-band-title"
                           Text="Unexpected error"/>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="CaptionClose"
                            Classes="caption close"
                            ToolTip.Tip="Close"
                            AutomationProperties.Name="Close">
                        <LucideIcon Classes="caption-icon" Kind="X"/>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Classes="dialog">
            <StackPanel Spacing="14">

                <TextBlock Text="Something went wrong"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Sx.TextPrimaryBrush}"/>

                <!-- What happened, in the exception's own words: the type and
                     the message. The stack itself lives in the log — a page
                     of it here would help nobody read the code. -->
                <TextBlock x:Name="Summary"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Sx.TextSecondaryBrush}"/>

                <!-- The code: large enough to read aloud, selectable so it can
                     be taken with the mouse alone. -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Error code"
                               FontSize="12"
                               Foreground="{DynamicResource Sx.TextSecondaryBrush}"/>
                    <SelectableTextBlock x:Name="IncidentCode"
                                         FontSize="22"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource Sx.TextPrimaryBrush}"/>
                </StackPanel>

                <!-- The one line the dialog differs by: whether the
                     application kept running or is on its way out. -->
                <TextBlock x:Name="Verdict"
                           FontSize="13"
                           LineHeight="18"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource Sx.TextSecondaryBrush}"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="Details were written to"
                               FontSize="12"
                               Foreground="{DynamicResource Sx.TextSecondaryBrush}"/>
                    <SelectableTextBlock x:Name="LogPath"
                                         FontSize="12"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource Sx.TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button x:Name="CopyButton"
                            Classes="button-ghost"
                            Content="Copy details"
                            Click="OnCopy"/>
                    <Button Content="Close"
                            IsDefault="True"
                            IsCancel="True"
                            Click="OnClose"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- The frame: one stroke along the window's edge, the theme's own
             line, brighter the while the window holds the eye. -->
        <chrome:ChromeFrame Grid.Row="0" Grid.RowSpan="2"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
