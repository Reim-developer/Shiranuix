<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shiranuix.ViewModels"
        xmlns:views="using:Shiranuix.Views"
        x:Class="Shiranuix.Views.PdfViewerWindow"
        x:DataType="vm:PdfViewerState"
        Title="{Binding Title}"
        Width="900"
        Height="720"
        MinWidth="560"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        Background="#1F1F1F">

    <!--
        The reader: a paper shown beside the writing, not in its place. The
        reading stands on one page at a time — the page shown whole, never
        cut — and steps on and back by the buttons, the wheel, and the keys;
        it also looks at the page larger or smaller than the glass offering
        it, by the steps beside the place it stands on. The chrome keeps to
        the page's edges: the window's own ledge above, the two steps below,
        so the glass between them is the paper's alone.
    -->

    <Window.Styles>
        <!-- The reader wears its own dark stage whatever the theme does, so
             the chrome carries its own light: a quiet touch on the buttons,
             a lighter one under the pointer, and a fading hand on a button
             that can no longer reach. -->
        <Style Selector="Button.reader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
        </Style>
        <Style Selector="Button.reader:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.reader:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="Button.reader:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.35"/>
        </Style>

        <!-- The window's own ledge and frame: the same three buttons and the
             same edge stroke as every other window, drawn for the dark stage
             whatever the theme does around it. -->
        <Style Selector="Border.frame">
            <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
        </Style>
        <Style Selector="Border.frame:active">
            <Setter Property="BorderBrush" Value="#FF6F6F6F"/>
        </Style>
        <Style Selector="Button.stage-caption">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.stage-caption /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.stage-caption:pointerover">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        <Style Selector="Button.stage-caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22FFFFFF"/>
        </Style>
        <Style Selector="Button.stage-caption:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="Button.stage-caption.close:pointerover">
            <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </Style>
        <Style Selector="Button.stage-caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E0C42B1C"/>
        </Style>
        <Style Selector=".stage-caption-icon" x:SetterTargetType="LucideIcon">
            <Setter Property="Size" Value="12"/>
            <Setter Property="StrokeWidth" Value="2"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0"
                x:Name="TitleBand"
                Padding="10,4,2,4"
                Background="#2A2A2A">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="1">
                <Button x:Name="CaptionMin"
                        Classes="stage-caption"
                        Focusable="False"
                        ToolTip.Tip="Minimize"
                        AutomationProperties.Name="Minimize">
                    <LucideIcon Classes="stage-caption-icon" Kind="Minus"/>
                </Button>
                <Button x:Name="CaptionMax"
                        Classes="stage-caption"
                        Focusable="False"
                        ToolTip.Tip="Maximize"
                        AutomationProperties.Name="Maximize">
                    <LucideIcon Classes="stage-caption-icon" Kind="Square"/>
                </Button>
                <Button x:Name="CaptionClose"
                        Classes="stage-caption close"
                        Focusable="False"
                        ToolTip.Tip="Close"
                        AutomationProperties.Name="Close">
                    <LucideIcon Classes="stage-caption-icon" Kind="X"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- The glass and the sheet: the glass holds what the window offers,
             and the sheet is never smaller than it, so a page at or under the
             fit sits in the middle of the window while one looked at larger
             grows past the glass and is reached by scrolling rather than
             being cut off at its edges. -->
        <Grid Grid.Row="1" x:Name="Stage">
            <ScrollViewer x:Name="Glass"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="Sheet"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top">
                    <Border BoxShadow="0 2 14 0 #66000000"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <Image x:Name="Leaf" Stretch="Fill"/>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2"
                Padding="10,8"
                Background="#2A2A2A">
            <StackPanel Orientation="Horizontal"
                        Spacing="24"
                        HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            Spacing="16">
                    <Button x:Name="Previous"
                            Classes="reader"
                            Click="OnPrevious"
                            Focusable="False"
                            ToolTip.Tip="Previous page">
                        <LucideIcon Classes="tool-icon" Kind="ChevronLeft"/>
                    </Button>
                    <TextBlock x:Name="Place"
                               VerticalAlignment="Center"
                               Foreground="#DDDDDD"/>
                    <Button x:Name="Next"
                            Classes="reader"
                            Click="OnNext"
                            Focusable="False"
                            ToolTip.Tip="Next page">
                        <LucideIcon Classes="tool-icon" Kind="ChevronRight"/>
                    </Button>
                </StackPanel>

                <!-- The sizes the reading is looked at, standing beside the
                     place it stands on: the mark in the middle is the fit,
                     and it is pressed to come back to it, while the two
                     steps either side grow or shrink the page by one rung. -->
                <StackPanel Orientation="Horizontal"
                            Spacing="1">
                    <Button x:Name="ZoomOut"
                            Classes="reader"
                            Click="OnZoomOut"
                            Focusable="False"
                            ToolTip.Tip="Zoom out (Ctrl+-)">
                        <LucideIcon Classes="tool-icon" Kind="ZoomOut"/>
                    </Button>
                    <Button x:Name="ZoomMark"
                            Classes="reader"
                            Click="OnZoomFit"
                            Focusable="False"
                            ToolTip.Tip="Zoom to fit (Ctrl+0)">
                        <TextBlock x:Name="ZoomText" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ZoomIn"
                            Classes="reader"
                            Click="OnZoomIn"
                            Focusable="False"
                            ToolTip.Tip="Zoom in (Ctrl+=)">
                        <LucideIcon Classes="tool-icon" Kind="ZoomIn"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- The frame: one stroke along the window's edge, standing over the
             ledge, the page and the steps, taking none of their room. -->
        <views:ChromeFrame Grid.Row="0" Grid.RowSpan="3"
                           Classes="frame"
                           IsHitTestVisible="False"/>

    </Grid>

</Window>
