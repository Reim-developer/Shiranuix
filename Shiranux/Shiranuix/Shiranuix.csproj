<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The mark the machine keeps for the editor itself: the taskbar, the
         title bars and the start screen each call for it, and each scales
         from the sizes inside the one file. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The release number, in the shape the assembly and any package
         take it. AppVersion in the project carries the same three parts
         for code to compare against; the two move together on release. -->
    <Version>0.6.6</Version>

    <!-- Startup. A writer who opens a text editor is waiting, and most of what
         they are waiting for is the runtime working out what it could have
         known at publish time: ReadyToRun does that work ahead of time, so
         the first window does not pay for it, at the price of a larger
         download. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- One language, a handful of numbers, no dates in words: ICU is tens of
         megabytes loaded to answer questions this editor never asks. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Profile-guided optimisation, on by default, named here because a
         startup budget is exactly what it is for. -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- What is inside the editor is not public API, but it is testable: the
         doors it opens are worth testing without a window. -->
    <InternalsVisibleTo Include="Shiranuix.Tests" />
  </ItemGroup>

  <ItemGroup>
        <!-- Icons: the symbol glyphs the title band's commands are drawn in.
             FASymbolIcon carries its own font inside the package and needs no
             theme include, so nothing about the app's own chrome changes. -->
        <!-- Icons: Lucide, the set every icon in the editor is named from, so
             the toolbar, the file tree and a panel's tab are all one hand. The
             icons are geometry rather than a font, which means no font has to
             ship beside them and every one is right in both themes. -->
        <PackageReference Include="Lucide.Avalonia" Version="0.2.26" />
        <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Dependency injection: Splat is the app's resolver (Locator.Current),
         Microsoft.Extensions.DependencyInjection is the container behind it,
         and the adapter below binds the two together. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <!-- Persistence: EF Core over SQLite, so the user's settings, recent files
         and font history outlive the session. Design is for the command-line
         migration tools only and never ships in the app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference><!-- Export to PDF:
         paper the size of an A4 page. It draws; it decides nothing about the
         words. MIT, and the one package here that touches a file format. -->
    <PackageReference Include="PDFsharp" Version="6.1.1" /><!-- Export to PDF:
         paper the size of an A4 page. It draws; it decides nothing about the
         words. MIT without a runtime license key (6.2 and later ask for one),
         which is why this rather than the newest. -->
    <!-- Reading a paper:
         the reader turns its pages, not the writing. PDFium does the
         drawing through PDFtoImage (SkiaSharp beneath it); MIT. -->
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <!-- The drawing engine's own native half, named at the version the
         graph already stands on: PDFtoImage asks for SkiaSharp 4.150 and
         the managed assembly is unified up to it, but Avalonia.Skia still
         asks for the plain Linux natives at 3.119 — two packages then drop
         a different libSkiaSharp.so at the very same place, and the older
         one wins the copy, which the managed side then refuses to load.
         Named here, the package resolves at 4.150 for everyone, and
         whichever of the two files lands is the one that fits. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Splat" Version="21.0.0" />
    <PackageReference Include="Splat.Microsoft.Extensions.DependencyInjection" Version="21.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The band's mark: the icon the title band draws instead of the letter
         and the name, carried as a resource the window can read directly. -->
    <AvaloniaResource Include="Assets\app-64.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The editor's own file shape, read and written: a library of its own,
         because the files it made must still open the day the app does not. -->
    <ProjectReference Include="..\Shiranuix.CoreFormat\Shiranuix.CoreFormat.csproj" />
    <!-- The editor's own thinking: what a document holds, where the caret
         stands in it, and every rule about moving over it. The window below
         answers to this, never the other way round. -->
    <ProjectReference Include="..\Shiranuix.CoreEditor\Shiranuix.CoreEditor.csproj" />
    <!-- The page's lines standing each at its own edge: the formatter the
         framework asks for by name, and the presenter that can ask it for
         a line at a time. Only the drawing reaches in here; what a line
         means stays with the document. -->
    <ProjectReference Include="..\Shiranuix.TextRender\Shiranuix.TextRender.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repository's own two rooms of shared UI: the palette every
         window's colours are named from, and the drawn chrome — frame,
         ledge and caption buttons — every window here draws for itself.
         They stand outside Shiranux because Narika draws from them too. -->
    <ProjectReference Include="..\..\Packages\Shiranuix.Theme\Shiranuix.Theme.csproj" />
    <ProjectReference Include="..\..\Packages\Shiranuix.WindowBorderless\Shiranuix.WindowBorderless.csproj" />
  </ItemGroup>
</Project>
