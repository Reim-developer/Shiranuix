<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Shiranuix.Plugins.Testing</PackageId>
    <Version>0.1.0</Version>
    <Authors>Reim</Authors>
    <Description>Fakes and a harness for testing Shiranuix plugins: a document door that keeps a file in memory, a dialog that answers from a script, a harness that hands a plugin its context, and a temporary folder tree to work against.</Description>
    <PackageTags>shiranuix;plugin;plugins;testing;editor</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only the contract and the assertion library. A testing helper that
         dragged anything else in would be the thing every plugin author's own
         test project has to fight. -->
    <ProjectReference Include="..\Shiranuix.Plugins\Shiranuix.Plugins.csproj" />
    <!-- A plugin with a panel cannot be tested without the panel contract, so
         the harness offers that door too - and with it, Avalonia. A test
         project for a plugin with no panel never touches any of it. -->
    <ProjectReference Include="..\Shiranuix.Plugins.UI\Shiranuix.Plugins.UI.csproj" />
    <PackageReference Include="xunit.assert" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>